+	}
+	// This declared fixture-only table maps model identities to native IDs.
+	// It does not infer a production reference system or truncate string IDs.
+	ids := map[string]byte{"ms-Z": 1, "ms-Q": 2, "default-ms-explicit-test": 3}
+	id, ok := ids[a.Identity]
+	if !ok || a.Version != 1 {
+		t.Fatal("unknown fixture axis", a)
+	}
+	profile := ProfileIntegerZ
+	if a.Profile == "Q" {
+		profile = ProfileRationalQ
