+func TestInstantUnitsSevenUnchangedGoldens(t *testing.T) {
+	seen := map[string]bool{}
+	for _, c := range loadInstantUnitGoldens(t) {
+		t.Run(c.ID, func(t *testing.T) {
+			if seen[c.ID] {
+				t.Fatal("duplicate golden", c.ID)
+			}
+			seen[c.ID] = true
+			if c.Kind == "codec_contract" {
+				testInstantCodecGolden(t, c.Expected)
+				return
+			}
+			if c.Kind != "unit_mapping" {
+				t.Fatal("unexpected golden kind", c.Kind)
+			}
+			a := fixtureInstantAxis(t, c.TargetAxis)
+			value := instantUnitRational(t, c.SourceCoordinate)
+			before := value.String()
+			p, err := ConvertCoordinateUnit(value, c.SourceUnit, a, Limits{})
+			if c.ExpectedError != "" {
+				want := map[string]error{"INCOMPATIBLE_DOMAIN": ErrIncompatibleDomain, "EXPLICIT_MAPPING_REQUIRED": ErrExplicitMappingRequired}[c.ExpectedError]
+				if want == nil || !errors.Is(err, want) || p.Profile() != 0 {
+					t.Fatal(c.ExpectedError, p, err)
+				}
+				return
+			}
+			var expected string
+			if err := json.Unmarshal(c.Expected, &expected); err != nil {
+				t.Fatal(err)
+			}
+			if err != nil || instantUnitValue(t, p) != expected || p.Axis().Descriptor() != a.Descriptor() || p.Axis().DefinitionHash() != a.DefinitionHash() || value.String() != before {
+				t.Fatal("conversion lost golden value/axis or changed input", p, err)
+			}
+			wire, err := AppendPosition(nil, p, Limits{})
+			if err != nil {
+				t.Fatal(err)
+			}
+			decoded, err := DecodePosition(wire, a, Limits{})
+			if err != nil || instantUnitValue(t, decoded) != expected {
+				t.Fatal("generic exact coordinate changed through bytes", decoded, err)
+			}
+		})
+	}
