+package temporal
+
+import (
+	"errors"
+
+	"github.com/data-insights-ai/rho-tkg/v5/pkg/types"
+)
+
+var (
+	// ErrInstantCodecRange identifies an integral millisecond coordinate outside
+	// the default signed int64 codec. The mathematical Z/Q domain is unaffected.
+	ErrInstantCodecRange = errors.New("temporal: instant codec range exceeded")
+	// ErrNonintegralInstantCodec identifies an exact fractional millisecond that
+	// cannot be represented by the default Instant codec without rounding.
+	ErrNonintegralInstantCodec = errors.New("temporal: nonintegral instant codec coordinate")
+)
+
+func instantAxis(axis Axis, l Limits) error {
+	if err := axis.validate(); err != nil {
+		return err
+	}
+	if err := axis.validateDescriptorBudget(l); err != nil {
+		return err
+	}
+	if axis.desc.CanonicalUnit != millisecondUnit {
+		return ErrExplicitMappingRequired
+	}
+	if axis.desc.Profile != ProfileIntegerZ {
+		return ErrIncompatibleDomain
+	}
+	return nil
+}
+
+// InstantPosition places a bounded millisecond codec value on an explicitly
+// supplied IntegerZ millisecond axis. ID, Reference and version are never
+// invented. This constructs a point coordinate, not an interval or clock reading.
+func InstantPosition(axis Axis, value types.Instant, l Limits) (Position, error) {
+	l, err := l.resolved()
+	if err != nil {
+		return Position{}, err
+	}
+	if err := instantAxis(axis, l); err != nil {
+		return Position{}, err
+	}
+	p := Position{axis: axis, integer: Int64(int64(value))}
+	if err := p.validate(l); err != nil {
+		return Position{}, err
+	}
+	if positionWireBytes(p) > l.MaxValueBytes {
+		return Position{}, ErrResourceLimit
+	}
+	return p, nil
+}
+
+// InstantFromPosition extracts only an exact numeric millisecond codec value
+// from a validated Z/Q point. It does not map between reference systems or
+// retain axis identity in the bare numeric result. Fractions and out-of-range
+// integers refuse separately; neither the general Z nor Q domain is narrowed.
+func InstantFromPosition(p Position, l Limits) (types.Instant, error) {
+	l, err := l.resolved()
+	if err != nil {
+		return 0, err
+	}
+	if err := p.validate(l); err != nil {
+		return 0, err
+	}
+	if positionWireBytes(p) > l.MaxValueBytes {
+		return 0, ErrResourceLimit
+	}
+	if p.axis.desc.CanonicalUnit != millisecondUnit {
+		return 0, ErrExplicitMappingRequired
+	}
+	var n Integer
+	switch p.Profile() {
+	case ProfileIntegerZ:
+		n = p.integer
+	case ProfileRationalQ:
+		if compareInteger(p.rational.Denominator(), Int64(1)) != Equal {
+			return 0, ErrNonintegralInstantCodec
+		}
+		n = p.rational.num
+	default:
+		return 0, ErrIncompatibleDomain
+	}
+	value, fits := n.Int64()
+	if !fits {
+		return 0, ErrInstantCodecRange
+	}
+	return types.Instant(value), nil
+}
+
+// AppendInstant uses the existing provisional TP position format on an explicit
+// IntegerZ millisecond axis. It introduces no new wire version or physical row
+// layout. Refusal preserves dst's length and every byte of its backing storage.
+func AppendInstant(dst []byte, value types.Instant, axis Axis, l Limits) ([]byte, error) {
+	p, err := InstantPosition(axis, value, l)
+	if err != nil {
+		return dst, err
+	}
+	return AppendPosition(dst, p, l)
+}
+
+// DecodeInstant validates the existing provisional TP frame and supplied
+// IntegerZ millisecond axis before applying the signed int64 codec range.
+// Generic DecodePosition still accepts exact wider Z and fractional Q values.
+func DecodeInstant(src []byte, axis Axis, l Limits) (types.Instant, error) {
+	l, err := l.resolved()
+	if err != nil {
+		return 0, err
+	}
+	if err := instantAxis(axis, l); err != nil {
+		return 0, err
+	}
+	p, err := DecodePosition(src, axis, l)
+	if err != nil {
+		return 0, err
+	}
+	return InstantFromPosition(p, l)
+}
