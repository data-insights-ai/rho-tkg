+func TestCoordinateUnitsShareImmutableWideInputs(t *testing.T) {
+	value := instantUnitRational(t, "123456789012345678901234567890/1000")
+	before := value.String()
+	axis := instantUnitAxis(t, ProfileIntegerZ, 71, "supplied-concurrent-reference", "microsecond")
+	var wg sync.WaitGroup
+	for range 4 {
+		wg.Go(func() {
+			for range 100 {
+				got, err := ConvertCoordinateUnit(value, "millisecond", axis, Limits{})
+				if err != nil {
+					t.Error(err)
+					return
+				}
+				integer, ok := got.Integer()
+				if !ok || integer.String() != "123456789012345678901234567890" {
+					t.Error("shared wide input changed", integer.String())
+					return
+				}
+			}
+		})
+	}
+	wg.Wait()
+	if value.String() != before {
+		t.Fatal("conversion mutated its immutable source", value.String(), before)
+	}
+}
