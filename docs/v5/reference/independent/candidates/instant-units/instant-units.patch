+func TestCoordinateUnitsCancellationWideningAndRefusal(t *testing.T) {
+	msZ := instantUnitAxis(t, ProfileIntegerZ, 10, "supplied-reference", "millisecond")
+	usZ := instantUnitAxis(t, ProfileIntegerZ, 11, "supplied-reference", "microsecond")
+	msQ := instantUnitAxis(t, ProfileRationalQ, 12, "supplied-reference", "millisecond")
+	for _, c := range []struct {
+		input, from string
+		axis        Axis
+		want        string
+	}{
+		{"0", "microsecond", msZ, "0"}, {"-1000", "microsecond", msZ, "-1"}, {"-1", "microsecond", msQ, "-1/1000"},
+		{"997/1000", "millisecond", usZ, "997"}, {"-997/1000", "millisecond", usZ, "-997"},
+		{"9223372036854775807", "millisecond", usZ, "9223372036854775807000"}, {"-9223372036854775808", "millisecond", usZ, "-9223372036854775808000"},
+		{"9223372036854775807000", "microsecond", msZ, "9223372036854775807"}, {"-9223372036854775808000", "microsecond", msZ, "-9223372036854775808"},
+		{"9223372036854775808000", "microsecond", msZ, "9223372036854775808"},
+	} {
+		r := instantUnitRational(t, c.input)
+		before := r.String()
+		p, err := ConvertCoordinateUnit(r, c.from, c.axis, Limits{})
+		if err != nil || instantUnitValue(t, p) != c.want || r.String() != before {
+			t.Fatal(c, p, err)
+		}
+	}
+	value := instantUnitRational(t, "997/1000")
+	p, err := ConvertCoordinateUnit(value, "millisecond", usZ, Limits{MaxMagnitudeBits: 10})
+	if err != nil || instantUnitValue(t, p) != "997" {
+		t.Fatal("uncancelled intermediate falsely refused representable result", p, err)
+	}
+	if _, err := ConvertCoordinateUnit(value, "millisecond", usZ, Limits{MaxMagnitudeBits: 9}); !errors.Is(err, ErrResourceLimit) {
+		t.Fatal("oversized input escaped via cancellation", err)
+	}
+	if _, err := ConvertCoordinateUnit(RationalInt64(0), "microsecond", msQ, Limits{MaxMagnitudeBits: 1}); err != nil {
+		t.Fatal("fixed scaling factor treated as stored coordinate", err)
+	}
+	if _, err := ConvertCoordinateUnit(RationalInt64(1), "microsecond", msQ, Limits{MaxMagnitudeBits: 9}); !errors.Is(err, ErrResourceLimit) {
+		t.Fatal("oversized resulting denominator accepted", err)
+	}
+	if _, err := ConvertCoordinateUnit(RationalInt64(math.MaxInt64), "millisecond", usZ, Limits{MaxMagnitudeBits: 64}); !errors.Is(err, ErrResourceLimit) {
+		t.Fatal("scaled magnitude overflow hidden", err)
+	}
+	for _, text := range []string{"1", "-1", "1001", "-1001"} {
+		if _, err := ConvertCoordinateUnit(instantUnitRational(t, text), "microsecond", msZ, Limits{}); !errors.Is(err, ErrIncompatibleDomain) {
+			t.Fatal("fractional Z coordinate rounded", text, err)
+		}
+	}
+}
