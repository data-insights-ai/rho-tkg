+func TestCoordinateUnitsAgainstIndependentBigRat(t *testing.T) {
+	rng := rand.New(rand.NewPCG(0x413c, 0x921f))
+	for step := range 300 {
+		n := int64(rng.Uint64() >> 1)
+		if step%2 == 0 {
+			n = -n
+		}
+		d := int64(rng.Uint64()%10000) + 1
+		text := strconv.FormatInt(n, 10) + "/" + strconv.FormatInt(d, 10)
+		original := instantUnitRational(t, text)
+		expected, ok := new(big.Rat).SetString(text)
+		if !ok {
+			t.Fatal(text)
+		}
+		from, to := "microsecond", "millisecond"
+		if step%2 == 0 {
+			from, to = "millisecond", "microsecond"
+			expected.Mul(expected, big.NewRat(1000, 1))
+		} else {
+			expected.Quo(expected, big.NewRat(1000, 1))
+		}
+		profile := ProfileRationalQ
+		if step%3 == 0 {
+			profile = ProfileIntegerZ
+		}
+		axis := instantUnitAxis(t, profile, 70, "explicit-property-reference", to)
+		got, err := ConvertCoordinateUnit(original, from, axis, Limits{})
+		if profile == ProfileIntegerZ && !expected.IsInt() {
+			if !errors.Is(err, ErrIncompatibleDomain) {
+				t.Fatal(text, expected, got, err)
+			}
+			continue
+		}
+		if err != nil || instantUnitValue(t, got) != expected.RatString() {
+			t.Fatal(text, expected, got, err)
+		}
+	}
+}
