+func testInstantCodecGolden(t *testing.T, raw json.RawMessage) {
+	t.Helper()
+	var golden struct {
+		Minimum    string `json:"minimum_ms"`
+		Maximum    string `json:"maximum_ms"`
+		Below      string `json:"below_minimum"`
+		Above      string `json:"above_maximum"`
+		Fractional string `json:"fractional_ms"`
+		DenseQ     string `json:"general_dense_Q_value"`
+	}
+	if err := json.Unmarshal(raw, &golden); err != nil {
+		t.Fatal(err)
+	}
+	if golden.Below != "INSTANT_CODEC_RANGE" || golden.Above != "INSTANT_CODEC_RANGE" || golden.Fractional != "NONINTEGRAL_INSTANT_CODEC" || golden.DenseQ != "1/1000 remains exact" {
+		t.Fatal("codec golden changed", golden)
+	}
+	z := instantUnitAxis(t, ProfileIntegerZ, 30, "explicit-default-test-reference", "millisecond")
+	q := instantUnitAxis(t, ProfileRationalQ, 31, "explicit-dense-test-reference", "millisecond")
+	for _, text := range []string{golden.Minimum, golden.Maximum, "0", "-123"} {
+		p, err := ConvertCoordinateUnit(instantUnitRational(t, text), "millisecond", z, Limits{})
+		if err != nil {
+			t.Fatal(err)
+		}
+		i, err := InstantFromPosition(p, Limits{})
+		if err != nil || strconv.FormatInt(int64(i), 10) != text {
+			t.Fatal("bounded instant changed exact coordinate", text, i, err)
+		}
+		wire, err := AppendInstant(nil, i, z, Limits{})
+		if err != nil {
+			t.Fatal(err)
+		}
+		decoded, err := DecodeInstant(wire, z, Limits{})
+		if err != nil || decoded != i {
+			t.Fatal("bounded codec failed edge round-trip", text, decoded, err)
+		}
+		ordinary, err := AppendPosition(nil, p, Limits{})
+		if err != nil || !bytes.Equal(wire, ordinary) {
+			t.Fatal("new wire format invented", err)
+		}
+	}
+	for _, text := range []string{adjacentInstantText(t, golden.Minimum, -1), adjacentInstantText(t, golden.Maximum, 1)} {
+		p, err := ConvertCoordinateUnit(instantUnitRational(t, text), "millisecond", z, Limits{})
+		if err != nil {
+			t.Fatal(err)
+		}
+		if _, err := InstantFromPosition(p, Limits{}); !errors.Is(err, ErrInstantCodecRange) {
+			t.Fatal("wide Z narrowed or wrapped", text, err)
+		}
+		wire, err := AppendPosition(nil, p, Limits{})
+		if err != nil {
+			t.Fatal("general Z was incorrectly width-limited", err)
+		}
+		if _, err := DecodeInstant(wire, z, Limits{}); !errors.Is(err, ErrInstantCodecRange) || errors.Is(err, ErrInvalidEncoding) {
+			t.Fatal("valid generic wide Z accepted or labelled malformed by default codec", err)
+		}
+	}
+	p, err := ConvertCoordinateUnit(instantUnitRational(t, "1/1000"), "millisecond", q, Limits{})
+	if err != nil {
+		t.Fatal(err)
+	}
+	if _, err := InstantFromPosition(p, Limits{}); !errors.Is(err, ErrNonintegralInstantCodec) {
+		t.Fatal("fractional ms silently narrowed", err)
+	}
+	wire, err := AppendPosition(nil, p, Limits{})
+	if err != nil {
+		t.Fatal(err)
+	}
+	decoded, err := DecodePosition(wire, q, Limits{})
+	if err != nil || instantUnitValue(t, decoded) != "1/1000" {
+		t.Fatal("dense Q was incorrectly reduced to Instant codec range", decoded, err)
+	}
+}
+
+func TestInstantNativeTypeZeroBoundariesAndQExtraction(t *testing.T) {
+	if reflect.TypeFor[types.Instant]().Kind() != reflect.Int64 {
+		t.Fatal("default Instant is not signed int64")
+	}
+	z := instantUnitAxis(t, ProfileIntegerZ, 40, "caller-reference", "millisecond")
+	q := instantUnitAxis(t, ProfileRationalQ, 41, "different-caller-reference", "millisecond")
+	for _, i := range []types.Instant{0, -1, 1, types.Instant(math.MinInt64), types.Instant(math.MaxInt64)} {
+		p, err := InstantPosition(z, i, Limits{})
+		if err != nil || p.Axis().Descriptor() != z.Descriptor() {
+			t.Fatal(i, p, err)
+		}
+		got, err := InstantFromPosition(p, Limits{})
+		if err != nil || got != i {
+			t.Fatal(i, got, err)
+		}
+		dense, err := RationalPosition(q, RationalInt64(int64(i)))
+		if err != nil {
+			t.Fatal(err)
+		}
+		got, err = InstantFromPosition(dense, Limits{})
+		if err != nil || got != i {
+			t.Fatal("numeric codec extraction guessed a reference mapping", i, got, err)
+		}
+	}
+	for _, text := range []string{"-1/1000", "1/3", "9223372036854775808"} {
+		p, err := RationalPosition(q, instantUnitRational(t, text))
+		if err != nil {
+			t.Fatal(err)
+		}
+		want := ErrNonintegralInstantCodec
+		if text == "9223372036854775808" {
+			want = ErrInstantCodecRange
+		}
+		if _, err := InstantFromPosition(p, Limits{}); !errors.Is(err, want) {
+			t.Fatal(text, err)
+		}
+	}
+	if _, err := InstantPosition(z, types.Instant(math.MinInt64), Limits{MaxMagnitudeBits: 63}); !errors.Is(err, ErrResourceLimit) {
+		t.Fatal(err)
+	}
+}
+
+func TestInstantAdmissionAndAppendBackingImmutability(t *testing.T) {
+	z := instantUnitAxis(t, ProfileIntegerZ, 50, "default-is-explicit", "millisecond")
+	q := instantUnitAxis(t, ProfileRationalQ, 51, "dense-is-explicit", "millisecond")
+	wrong := instantUnitAxis(t, ProfileIntegerZ, 52, "ordinal-is-explicit", "ordinal")
+	for _, c := range []struct {
+		axis Axis
+		l    Limits
+		want error
+	}{
+		{Axis{}, Limits{}, ErrInvalidAxis}, {wrong, Limits{}, ErrExplicitMappingRequired}, {q, Limits{}, ErrIncompatibleDomain},
+		{z, Limits{MaxValueBytes: 55}, ErrResourceLimit}, {z, Limits{MaxDescriptorBytes: 1}, ErrResourceLimit},
+		{z, Limits{MaxMagnitudeBits: 1}, ErrResourceLimit}, {z, Limits{MaxInputBytes: -1}, ErrInvalidLimits},
+	} {
+		backing := bytes.Repeat([]byte{0xa5}, 256)
+		prefix := backing[:4]
+		before := bytes.Clone(backing)
+		out, err := AppendInstant(prefix, 2, c.axis, c.l)
+		if !errors.Is(err, c.want) || len(out) != len(prefix) || !bytes.Equal(backing, before) {
+			t.Fatal("refused append changed caller backing", c, out, err)
+		}
+		if _, err := InstantPosition(c.axis, 2, c.l); !errors.Is(err, c.want) {
+			t.Fatal(c, err)
+		}
+	}
+	if _, err := InstantFromPosition(Position{}, Limits{}); !errors.Is(err, ErrInvalidPosition) {
+		t.Fatal(err)
+	}
+	p, _ := IntegerPosition(wrong, Int64(0))
+	if _, err := InstantFromPosition(p, Limits{}); !errors.Is(err, ErrExplicitMappingRequired) {
+		t.Fatal(err)
+	}
+	lex := instantUnitAxis(t, ProfileLexicographicQN, 53, "no-microstep-erasure", "millisecond")
+	lp, _ := LexPosition(lex, RationalInt64(0), Int64(0))
+	if _, err := InstantFromPosition(lp, Limits{}); !errors.Is(err, ErrIncompatibleDomain) {
+		t.Fatal(err)
+	}
+	good, _ := IntegerPosition(z, Int64(2))
+	for _, l := range []Limits{{MaxValueBytes: 55}, {MaxDescriptorBytes: 1}, {MaxMagnitudeBits: 1}} {
+		if _, err := InstantFromPosition(good, l); !errors.Is(err, ErrResourceLimit) {
+			t.Fatal(l, err)
+		}
+	}
+	if _, err := InstantFromPosition(good, Limits{MaxInputBytes: -1}); !errors.Is(err, ErrInvalidLimits) {
+		t.Fatal(err)
+	}
+}
+
+func TestInstantDecodeRejectsMalformedAndConflictingAxes(t *testing.T) {
+	z := instantUnitAxis(t, ProfileIntegerZ, 60, "supplied-A", "millisecond")
+	wire, err := AppendInstant(nil, types.Instant(math.MinInt64), z, Limits{})
+	if err != nil {
+		t.Fatal(err)
+	}
+	for n := range len(wire) {
+		if _, err := DecodeInstant(wire[:n], z, Limits{}); !errors.Is(err, ErrInvalidEncoding) {
+			t.Fatal("truncated input accepted", n, err)
+		}
+	}
+	for _, c := range []struct {
+		offset int
+		want   error
+	}{{0, ErrInvalidEncoding}, {2, ErrUnknownVersion}, {3, ErrUnknownProfile}, {4, ErrAxisMismatch}, {20, ErrAxisMismatch}} {
+		bad := bytes.Clone(wire)
+		bad[c.offset] = 255
+		if _, err := DecodeInstant(bad, z, Limits{}); !errors.Is(err, c.want) || (errors.Is(c.want, ErrUnknownVersion) || errors.Is(c.want, ErrUnknownProfile)) && !errors.Is(err, ErrInvalidEncoding) {
+			t.Fatal(c, err)
+		}
+	}
+	if _, err := DecodeInstant(append(bytes.Clone(wire), 0), z, Limits{}); !errors.Is(err, ErrInvalidEncoding) {
+		t.Fatal(err)
+	}
+	changedReference := instantUnitAxis(t, ProfileIntegerZ, 60, "supplied-B", "millisecond")
+	if _, err := DecodeInstant(wire, changedReference, Limits{}); !errors.Is(err, ErrAxisMismatch) {
+		t.Fatal("definition conflict lost", err)
+	}
+	wrongUnit := instantUnitAxis(t, ProfileIntegerZ, 60, "supplied-A", "microsecond")
+	if _, err := DecodeInstant(wire, wrongUnit, Limits{}); !errors.Is(err, ErrExplicitMappingRequired) {
+		t.Fatal(err)
+	}
+	q := instantUnitAxis(t, ProfileRationalQ, 61, "supplied-dense", "millisecond")
+	if _, err := DecodeInstant(wire, q, Limits{}); !errors.Is(err, ErrIncompatibleDomain) {
+		t.Fatal(err)
+	}
+	if _, err := DecodeInstant(wire, Axis{}, Limits{}); !errors.Is(err, ErrInvalidAxis) {
+		t.Fatal(err)
+	}
+	for _, l := range []Limits{{MaxInputBytes: 1}, {MaxValueBytes: 1}, {MaxDescriptorBytes: 1}} {
+		if _, err := DecodeInstant(wire, z, l); !errors.Is(err, ErrResourceLimit) {
+			t.Fatal(l, err)
+		}
+	}
+	if _, err := DecodeInstant(wire, z, Limits{MaxInputBytes: -1}); !errors.Is(err, ErrInvalidLimits) {
+		t.Fatal(err)
+	}
+}
+
+func TestInstantCodecExactByteLimit(t *testing.T) {
+	axis := instantUnitAxis(t, ProfileIntegerZ, 72, "caller-exact-byte-reference", "millisecond")
+	l := Limits{MaxInputBytes: 63, MaxValueBytes: 63}
+	wire, err := AppendInstant(nil, types.Instant(math.MinInt64), axis, l)
+	if err != nil || len(wire) != 63 {
+		t.Fatal(len(wire), err)
+	}
+	got, err := DecodeInstant(wire, axis, l)
+	if err != nil || got != types.Instant(math.MinInt64) {
+		t.Fatal(got, err)
+	}
+	if _, err := DecodeInstant(wire, axis, Limits{MaxInputBytes: 62}); !errors.Is(err, ErrResourceLimit) {
+		t.Fatal(err)
+	}
+	backing := bytes.Repeat([]byte{0xb4}, 128)
+	before := bytes.Clone(backing)
+	out, err := AppendInstant(backing[:3], types.Instant(math.MinInt64), axis, Limits{MaxValueBytes: 62})
+	if !errors.Is(err, ErrResourceLimit) || len(out) != 3 || !bytes.Equal(backing, before) {
+		t.Fatal("one-byte-short append partially published", err)
+	}
+}
