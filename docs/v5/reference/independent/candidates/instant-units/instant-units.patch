+package temporal
+
+import (
+	"errors"
+	"math/big"
+	"strings"
+	"unicode/utf8"
+)
+
+var (
+	// ErrExplicitMappingRequired identifies an unequal unit pair without the
+	// scalar arithmetic mapping supplied by this candidate. Ordinal coordinates
+	// never acquire elapsed-time meaning from their numeric shape.
+	ErrExplicitMappingRequired = errors.New("temporal: explicit coordinate unit mapping required")
+	// ErrInvalidUnit identifies empty, whitespace-only or invalid UTF-8 source
+	// unit names. Valid spellings are exact, never trimmed or normalized.
+	ErrInvalidUnit = errors.New("temporal: invalid coordinate unit")
+)
+
+const millisecondUnit = "millisecond"
+const microsecondUnit = "microsecond"
+
+// ConvertCoordinateUnit performs explicitly requested scalar point arithmetic
+// and preserves the entire caller-supplied target axis. Exact equal-unit
+// identity also permits ordinal/unknown declared units. The only unequal unit
+// pairs implemented here are microsecond/millisecond, by exact factor 1000.
+// Z refuses fractional results; Q preserves them. Q×N declines because no
+// microstep or elapsed-time interpretation is supplied. This is not a mapping
+// between reference systems and does not convert scope/interval-domain support.
+// API and wire choices remain provisional before the distributed format freeze.
+func ConvertCoordinateUnit(value Rational, sourceUnit string, target Axis, l Limits) (Position, error) {
+	l, err := l.resolved()
+	if err != nil {
+		return Position{}, err
+	}
+	if len(sourceUnit) > l.MaxInputBytes {
+		return Position{}, ErrResourceLimit
+	}
+	if !utf8.ValidString(sourceUnit) || strings.TrimSpace(sourceUnit) == "" {
+		return Position{}, ErrInvalidUnit
+	}
+	if err := target.validate(); err != nil {
+		return Position{}, err
+	}
+	if err := target.validateDescriptorBudget(l); err != nil {
+		return Position{}, err
+	}
+	scale := 0
+	switch {
+	case sourceUnit == target.desc.CanonicalUnit:
+	case sourceUnit == microsecondUnit && target.desc.CanonicalUnit == millisecondUnit:
+		scale = -1
+	case sourceUnit == millisecondUnit && target.desc.CanonicalUnit == microsecondUnit:
+		scale = 1
+	default:
+		return Position{}, ErrExplicitMappingRequired
+	}
+	if target.desc.Profile != ProfileIntegerZ && target.desc.Profile != ProfileRationalQ {
+		return Position{}, ErrIncompatibleDomain
+	}
+	if err := value.validate(l); err != nil {
+		return Position{}, err
+	}
+	if integerWireBytes(value.num)+integerWireBytes(value.Denominator()) > l.MaxValueBytes {
+		return Position{}, ErrResourceLimit
+	}
+	if scale != 0 {
+		value, err = scaleMillisecondMicrosecond(value, scale > 0, l)
+		if err != nil {
+			return Position{}, err
+		}
+	}
+	var p Position
+	if target.desc.Profile == ProfileIntegerZ {
+		if compareInteger(value.Denominator(), Int64(1)) != Equal {
+			return Position{}, ErrIncompatibleDomain
+		}
+		p = Position{axis: target, integer: value.num}
+	} else {
+		p = Position{axis: target, rational: value}
+	}
+	if err := p.validate(l); err != nil {
+		return Position{}, err
+	}
+	if positionWireBytes(p) > l.MaxValueBytes {
+		return Position{}, ErrResourceLimit
+	}
+	return p, nil
+}
+
+func scaleMillisecondMicrosecond(value Rational, multiply bool, l Limits) (Rational, error) {
+	if value.num.Sign() == 0 {
+		return Rational{}, nil
+	}
+	// Input magnitudes were checked before any big.Int copies. Cancellation
+	// avoids refusing a representable result due to an unreduced intermediate.
+	// The fixed factor adds at most 10 scratch bits, never unbounded arithmetic.
+	num, den := value.num.bigCopy(), value.Denominator().bigCopy()
+	factor := big.NewInt(1000)
+	g := new(big.Int)
+	if multiply {
+		g.GCD(nil, nil, den, factor)
+		den.Quo(den, g)
+		factor.Quo(factor, g)
+		num.Mul(num, factor)
+	} else {
+		g.GCD(nil, nil, num, factor)
+		num.Quo(num, g)
+		factor.Quo(factor, g)
+		den.Mul(den, factor)
+	}
+	return Fraction(ownedInteger(num), ownedInteger(den), l)
+}
