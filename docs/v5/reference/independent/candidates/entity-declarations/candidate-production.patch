--- /dev/null
+++ b/v5/internal/graphstate/declaration.go
@@ -0,0 +1,76 @@
+package graphstate
+
+import (
+	"strings"
+	"unicode"
+	"unicode/utf8"
+)
+
+// Interpretation is a supplied, preservation-only declaration about this
+// immutable entity record. It never follows from entity kind or support shape.
+// Empty means undeclared. Unknown tokens decline in this provisional subset;
+// this is not an opaque extension registry or a semantic equality capability.
+type Interpretation string
+
+const (
+	InterpretationOccurrence       Interpretation = "occurrence"
+	InterpretationState            Interpretation = "state"
+	InterpretationObservation      Interpretation = "observation"
+	InterpretationAssertedRelation Interpretation = "asserted_relation"
+	InterpretationConstraint       Interpretation = "constraint"
+	InterpretationDerivedAssertion Interpretation = "derived_assertion"
+)
+
+// TemporalRole preserves the meaning declared for the record's native Axis
+// association. It supplies no roles for property values or other axes, and no
+// clock, causality or calendar evaluator. Empty means undeclared.
+type TemporalRole string
+
+const (
+	TemporalRoleOccurrenceTime   TemporalRole = "occurrence_time"
+	TemporalRoleSourceOccurrence TemporalRole = "source_occurrence"
+	TemporalRoleValidity         TemporalRole = "validity"
+	TemporalRoleCausalOrder      TemporalRole = "causal_order"
+)
+
+// Declaration accounting is a provisional conservative record envelope: two
+// uint32-length frames plus exact token bytes when either field is declared.
+// Two undeclared fields have no declaration envelope. It is not a compact wire layout,
+// total operation-input bound or physical allocator/RSS measurement.
+func declarationBytes(record EntityRecord) int {
+	if record.Interpretation == "" && record.TemporalRole == "" {
+		return 0
+	}
+	return 8 + len(record.Interpretation) + len(record.TemporalRole)
+}
+func entityBytes(record EntityRecord) int {
+	return 64 + len(record.Type) + axisBytes(record.Axis) + declarationBytes(record)
+}
+func validateDeclarations(record EntityRecord, limits Limits) error {
+	for _, token := range []string{string(record.Interpretation), string(record.TemporalRole)} {
+		if len(token) > limits.MaxNameBytes {
+			return ErrResourceLimit
+		}
+		if !utf8.ValidString(token) || strings.IndexFunc(token, func(r rune) bool { return unicode.IsControl(r) || unicode.IsSpace(r) }) >= 0 {
+			return ErrInvalidInput
+		}
+	}
+	switch record.Interpretation {
+	case "", InterpretationOccurrence, InterpretationState, InterpretationObservation, InterpretationAssertedRelation, InterpretationConstraint, InterpretationDerivedAssertion:
+	default:
+		return ErrUnsupported
+	}
+	switch record.TemporalRole {
+	case "", TemporalRoleOccurrenceTime, TemporalRoleSourceOccurrence, TemporalRoleValidity, TemporalRoleCausalOrder:
+	default:
+		return ErrUnsupported
+	}
+	return nil
+}
+func ownDeclarations(record EntityRecord) EntityRecord {
+	// Copy short supplied tokens so a known token sliced from an unrelated large
+	// backing string cannot make the owned Delta/Projection retain that backing.
+	record.Interpretation = Interpretation(strings.Clone(string(record.Interpretation)))
+	record.TemporalRole = TemporalRole(strings.Clone(string(record.TemporalRole)))
+	return record
+}
