+func TestDeclarationInactiveIdentityRetainsSuppliedMetadataAndAbsenceDoesNot(t *testing.T) {
+	v := declarationFixture(t)
+	old := v.clone()
+	for _, owner := range []EntityID{1, 3} {
+		record := v.entities[owner]
+		d, err := Plan(t.Context(), v, []Operation{{Kind: Close, Owner: owner, Life: 1, Scope: testSpan(t, v.axis, 0, 10)}}, declarationRevision(t), Limits{})
+		if err != nil {
+			t.Fatal(err)
+		}
+		v.install(t, d)
+		p, err := Project(t.Context(), v, owner, testPosition(t, v.axis, 5), Effective, Limits{})
+		if err != nil || !p.Exists || p.Active || p.Record != record {
+			t.Fatal("closed identity lost declarations", owner, err)
+		}
+		p, err = Project(t.Context(), old, owner, testPosition(t, v.axis, 5), Effective, Limits{})
+		if err != nil || !p.Active || p.Record != record {
+			t.Fatal("old active record changed", owner, err)
+		}
+	}
+	bad := &declarationBadRead{fixtureView: v, owner: 99, record: EntityRecord{Interpretation: InterpretationOccurrence}, found: false}
+	p, err := Project(t.Context(), bad, 99, testPosition(t, v.axis, 5), Effective, Limits{})
+	if !errors.Is(err, ErrContradictoryRead) || !reflect.DeepEqual(p, Projection{}) {
+		t.Fatal("absent provider invented declaration", err)
+	}
+}
