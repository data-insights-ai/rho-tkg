+	for _, n := range []int{-1, 64<<20 + 1} {
+		if err := (Limits{MaxInputMetadataBytes: n}).Validate(); !errors.Is(err, ErrInvalidInput) {
+			t.Fatal("invalid metadata input policy", n, err)
