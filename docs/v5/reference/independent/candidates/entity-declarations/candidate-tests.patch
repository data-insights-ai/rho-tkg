+func TestDeclarationMetadataInputExactFitAndRepeatedOccurrences(t *testing.T) {
+	for _, kind := range []EntityKind{Node, Relationship} {
+		v := declarationFixture(t)
+		record := EntityRecord{Interpretation: InterpretationState, TemporalRole: TemporalRoleValidity}
+		opKind := CreateNode
+		if kind == Relationship {
+			opKind = CreateRelationship
+			record.Type = "R"
+			record.Source = 1
+			record.Target = 2
+			record.Mode = IdentityReference
+		}
+		op := Operation{Kind: opKind, Owner: 10, Life: 1, Scope: testSpan(t, v.axis, 0, 1), Record: record}
+		// Fixed independent literal: two uint32-length frames plus exact supplied
+		// token bytes. This is declaration-input policy, not total operation bytes.
+		bytes := 8 + len("state") + len("validity")
+		l := DefaultLimits()
+		l.MaxInputMetadataBytes = bytes
+		if _, err := Plan(t.Context(), v, []Operation{op}, declarationRevision(t), l); err != nil {
+			t.Fatal("exact metadata input fit", err)
+		}
+		l.MaxInputMetadataBytes = bytes - 1
+		d, err := Plan(t.Context(), v, []Operation{op}, declarationRevision(t), l)
+		declarationEmptyDelta(t, d, err, ErrResourceLimit)
+		second := op
+		second.Owner = 11
+		l.MaxInputMetadataBytes = 2 * bytes
+		if _, err = Plan(t.Context(), v, []Operation{op, second}, declarationRevision(t), l); err != nil {
+			t.Fatal("two exact input occurrences fit", err)
+		}
+		l.MaxInputMetadataBytes = 2*bytes - 1
+		d, err = Plan(t.Context(), v, []Operation{op, second}, declarationRevision(t), l)
+		declarationEmptyDelta(t, d, err, ErrResourceLimit)
+	}
+}
