+func TestDeclarationReadAndOutputBudgetsExactFitAndMetadataDifference(t *testing.T) {
+	for _, owner := range []EntityID{1, 3} {
+		for _, ledger := range []string{"read", "output"} {
+			t.Run(ledger+"/"+map[EntityID]string{1: "node", 3: "rel"}[owner], func(t *testing.T) {
+				v := declarationFixture(t)
+				before := v.clone()
+				plain := v.clone()
+				record := plain.entities[owner]
+				record.Interpretation = ""
+				record.TemporalRole = ""
+				plain.entities[owner] = record
+				// This reference/minimum search finds the existing nonmetadata portion of
+				// the read ledger. The expected declaration difference is independently
+				// fixed by literal token byte lengths, never entityBytes/engine counters.
+				delta := 8 + len(string(v.entities[owner].Interpretation)) + len(string(v.entities[owner].TemporalRole))
+				if ledger == "read" {
+					// The reviewed Project API performs the primary identity read and
+					// a second owner read while checking its immutable LifeRecord.
+					// Each actual reader occurrence carries the complete token bytes.
+					delta *= 2
+				}
+				run := func(view *fixtureView, cap int) (Projection, error) {
+					l := DefaultLimits()
+					if ledger == "read" {
+						l.MaxReadBytes = cap
+					} else {
+						l.MaxDeltaBytes = cap
+					}
+					return Project(t.Context(), view, owner, testPosition(t, v.axis, 5), Effective, l)
+				}
+				minFit := func(view *fixtureView) int {
+					lo, hi := 1, 65536
+					for lo < hi {
+						mid := lo + (hi-lo)/2
+						_, err := run(view, mid)
+						if err == nil {
+							hi = mid
+						} else if errors.Is(err, ErrResourceLimit) || errors.Is(err, state.ErrResourceLimit) {
+							lo = mid + 1
+						} else {
+							t.Fatal(err)
+						}
+					}
+					return lo
+				}
+				plainFit, declaredFit := minFit(plain), minFit(v)
+				if declaredFit != plainFit+delta {
+					t.Fatalf("complete metadata ledger difference=%d want=%d", declaredFit-plainFit, delta)
+				}
+				p, err := run(v, declaredFit)
+				if err != nil || p.Record.Interpretation != v.entities[owner].Interpretation {
+					t.Fatal("valid metadata exact fit", err)
+				}
+				p, err = run(v, declaredFit-1)
+				if !errors.Is(err, ErrResourceLimit) || !reflect.DeepEqual(p, Projection{}) {
+					t.Fatal("metadata projection one-byte refusal", err)
+				}
+				if _, err = run(plain, declaredFit-1); err != nil {
+					t.Fatal("same projection without tokens must fit", err)
+				}
+				declarationSameViews(t, before, v)
+			})
+		}
+	}
+}
