+func TestDeclarationCreateOnlyRejectsLifecycleAndPropertyOverridesAtomically(t *testing.T) {
+	for _, owner := range []EntityID{1, 3} {
+		for _, kind := range []OperationKind{Reopen, Close, Correct, Set, Unset, Add, Remove} {
+			t.Run(map[OperationKind]string{Reopen: "reopen", Close: "close", Correct: "correct", Set: "set", Unset: "unset", Add: "add", Remove: "remove"}[kind]+"/"+map[EntityID]string{1: "node", 3: "rel"}[owner], func(t *testing.T) {
+				v := declarationFixture(t)
+				before := v.clone()
+				scope := testSpan(t, v.axis, 0, 10)
+				life := LifeID(1)
+				if kind == Reopen {
+					scope = testSpan(t, v.axis, 10, 12)
+					life = 2
+				}
+				card := ScalarCardinality
+				name := "p"
+				if kind == Add || kind == Remove {
+					card = SetCardinality
+				}
+				entityKind := v.entities[owner].Kind
+				v.defs[ownerSchemaKey{entityKind, name}] = PropertyDefinition{Name: name, Owner: entityKind, Type: ScalarString, Cardinality: card}
+				before = v.clone()
+				// The first valid tentative property mutation must not escape when a later
+				// operation tries to revise immutable interpretation/axis-role declarations.
+				scalarName := "scalar"
+				v.defs[ownerSchemaKey{entityKind, scalarName}] = PropertyDefinition{Name: scalarName, Owner: entityKind, Type: ScalarString, Cardinality: ScalarCardinality}
+				before = v.clone()
+				ops := []Operation{{Kind: Set, Owner: owner, Life: 1, Scope: testSpan(t, v.axis, 0, 2), Name: scalarName, Value: String("tentative"), ValueID: 10}, {Kind: kind, Owner: owner, Life: life, Scope: scope, Name: name, Value: String("new"), ValueID: 11, Present: true, Record: EntityRecord{Interpretation: InterpretationConstraint}}}
+				d, err := Plan(t.Context(), v, ops, declarationRevision(t), Limits{})
+				declarationEmptyDelta(t, d, err, ErrInvalidInput)
+				declarationSameViews(t, before, v)
+			})
+		}
+	}
+	for _, kind := range []OperationKind{AddLabel, RemoveLabel} {
+		t.Run(map[OperationKind]string{AddLabel: "add-label", RemoveLabel: "remove-label"}[kind], func(t *testing.T) {
+			v := declarationFixture(t)
+			d, err := Plan(t.Context(), v, []Operation{{Kind: kind, Owner: 1, Life: 1, Scope: testSpan(t, v.axis, 0, 10), Name: "Label", Record: EntityRecord{TemporalRole: TemporalRoleCausalOrder}}}, declarationRevision(t), Limits{})
+			declarationEmptyDelta(t, d, err, ErrInvalidInput)
+		})
+	}
+}
