+func declarationFixture(t testing.TB) *fixtureView {
+	t.Helper()
+	v := newFixtureView(t)
+	whole := testSpan(t, v.axis, 0, 10)
+	rev, err := state.NewRevision(1, 1)
+	if err != nil {
+		t.Fatal(err)
+	}
+	delta, err := Plan(t.Context(), v, []Operation{{Kind: CreateNode, Owner: 1, Life: 1, Scope: whole, Record: EntityRecord{Interpretation: InterpretationOccurrence, TemporalRole: TemporalRoleSourceOccurrence}}, {Kind: CreateNode, Owner: 2, Life: 1, Scope: whole}, {Kind: CreateRelationship, Owner: 3, Life: 1, Scope: whole, Record: EntityRecord{Type: "R", Source: 1, Target: 2, Mode: IdentityReference, Interpretation: InterpretationState, TemporalRole: TemporalRoleValidity}}}, rev, Limits{})
+	if err != nil {
+		t.Fatal(err)
+	}
+	v.install(t, delta)
+	v.id[0]++
+	return v
+}
+func declarationRevision(t testing.TB) state.Revision {
+	t.Helper()
+	rev, err := state.NewRevision(2, 2)
+	if err != nil {
+		t.Fatal(err)
+	}
+	return rev
+}
+func declarationEmptyDelta(t testing.TB, d Delta, err, want error) {
+	t.Helper()
+	if !errors.Is(err, want) || !reflect.DeepEqual(d, Delta{}) {
+		t.Fatalf("want atomic %v, got %v; empty=%v", want, err, reflect.DeepEqual(d, Delta{}))
+	}
+}
+func declarationSameViews(t testing.TB, before, after *fixtureView) {
+	t.Helper()
+	for _, at := range []int64{0, 3, 5, 7, 9, 10} {
+		for _, owner := range []EntityID{1, 2, 3} {
+			a, err := Project(t.Context(), before, owner, testPosition(t, before.axis, at), Effective, Limits{})
+			if err != nil {
+				t.Fatal(err)
+			}
+			b, err := Project(t.Context(), after, owner, testPosition(t, after.axis, at), Effective, Limits{})
+			if err != nil || !reflect.DeepEqual(a, b) {
+				t.Fatalf("retained complete projection changed owner=%d at=%d: %v", owner, at, err)
+			}
+		}
+	}
+}
