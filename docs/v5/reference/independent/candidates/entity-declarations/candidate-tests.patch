+				v := declarationFixture(t)
+				record := EntityRecord{Interpretation: interpretation, TemporalRole: role}
+				opKind := CreateNode
+				if kind == Relationship {
+					opKind = CreateRelationship
+					record.Type = "R"
+					record.Source = 1
+					record.Target = 2
+					record.Mode = IdentityReference
+				}
+				d, err := Plan(t.Context(), v, []Operation{{Kind: opKind, Owner: 10, Life: 1, Scope: testSpan(t, v.axis, 0, 1), Record: record}}, declarationRevision(t), Limits{})
+				if err != nil {
