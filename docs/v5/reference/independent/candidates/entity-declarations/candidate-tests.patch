+type indGraphAdapter struct {
+	view   *fixtureView
+	ids    map[string]EntityID
+	names  map[EntityID]string
+	values ValueID
+}
+
+func indGraph(t testing.TB, c map[string]any) *indGraphAdapter {
+	t.Helper()
+	v := newFixtureView(t)
+	v.axis = indAxis(t, c["axis"])
+	g := &indGraphAdapter{view: v, ids: map[string]EntityID{}, names: map[EntityID]string{}, values: 1}
+	if definitions, ok := c["schema_definitions"].([]any); ok {
+		for _, raw := range definitions {
+			d := indObj(raw)
+			owner := Node
+			if d["owner"] == "edge" {
+				owner = Relationship
+			}
+			card := ScalarCardinality
+			if d["cardinality"] == "set" {
+				card = SetCardinality
+			}
+			unique := UniqueNone
+			if d["unique"] == "scalar" {
+				unique = UniqueScalar
+			}
+			if d["unique"] == "members" {
+				unique = UniqueMembers
+			}
+			name := indText(d["name"])
+			v.defs[ownerSchemaKey{owner, name}] = PropertyDefinition{Name: name, Owner: owner, Type: map[string]ScalarKind{"String": ScalarString, "Bool": ScalarBool, "I64": ScalarI64}[indText(d["type"])], Cardinality: card, Unique: unique}
+		}
+	}
+	for _, step := range indList(c["steps"]) {
+		for _, raw := range indList(indObj(step)["operations"]) {
+			op := indObj(raw)
+			for _, field := range []string{"id", "owner", "source", "target"} {
+				if name, ok := op[field].(string); ok {
+					g.identify(name)
+				}
+			}
+		}
+	}
+	return g
+}
+func (g *indGraphAdapter) identify(name string) EntityID {
+	if id, ok := g.ids[name]; ok {
+		return id
+	}
+	id := EntityID(len(g.ids) + 1)
+	g.ids[name] = id
+	g.names[id] = name
+	return id
+}
+func (g *indGraphAdapter) operations(t testing.TB, raws []any) []Operation {
+	t.Helper()
+	ops := []Operation{}
+	for _, item := range raws {
+		raw := indObj(item)
+		name, _ := raw["owner"].(string)
+		if name == "" {
+			name = indText(raw["id"])
+		}
+		owner := g.identify(name)
+		life := LifeID(1)
+		if raw["life"] != nil {
+			n, e := strconv.ParseUint(indText(raw["life"]), 10, 64)
+			if e != nil {
+				t.Fatal(e)
+			}
+			life = LifeID(n)
+		}
+		op := Operation{Owner: owner, Life: life, Scope: indOpScope(t, g.view.axis, raw), Present: indBool(raw["present"], false)}
+		switch indText(raw["op"]) {
+		case "create_vertex":
+			op.Kind = CreateNode
+		case "create_edge":
+			op.Kind = CreateRelationship
+			mode := LifeBound
+			if raw["reference_mode"] == "identity_reference" {
+				mode = IdentityReference
+			}
+			op.Record = EntityRecord{Source: g.identify(indText(raw["source"])), Target: g.identify(indText(raw["target"])), Type: indText(raw["type"]), Mode: mode}
+			if mode == LifeBound {
+				op.Binding = LifeRecord{SourceLife: 1, TargetLife: 1}
+			}
+		case "reopen":
+			op.Kind = Reopen
+		case "close":
+			op.Kind = Close
+		case "correct":
+			op.Kind = Correct
+		case "set":
+			op.Kind = Set
+		case "unset":
+			op.Kind = Unset
+		case "add":
+			op.Kind = Add
+		case "remove":
+			op.Kind = Remove
+		case "add_label":
+			op.Kind = AddLabel
+		case "remove_label":
+			op.Kind = RemoveLabel
+		default:
+			t.Fatal("unadapted graph operation", raw["op"])
+		}
+		if op.Kind == CreateNode || op.Kind == CreateRelationship {
+			if value, supplied := raw["interpretation"]; supplied {
+				op.Record.Interpretation = Interpretation(indText(value))
+			}
+			if value, supplied := raw["temporal_role"]; supplied {
+				op.Record.TemporalRole = TemporalRole(indText(value))
+			}
+		}
+		if raw["key"] != nil {
+			op.Name = indText(raw["key"])
+		}
+		if raw["label"] != nil {
+			op.Name = indText(raw["label"])
+		}
+		kind := Node
+		if r, ok := g.view.entities[owner]; ok {
+			kind = r.Kind
+		}
+		if op.Kind == CreateRelationship {
+			kind = Relationship
+		}
+		define := func(name string, value Scalar) {
+			scalarKind := value.Kind()
+			if scalarKind == ScalarNull {
+				scalarKind = ScalarString
+			}
+			if prior, ok := g.view.defs[ownerSchemaKey{kind, name}]; ok {
+				if prior.Owner != kind {
+					t.Fatal("owner-qualified property lookup mismatch:", name)
+				}
+				return
+			}
+			g.view.defs[ownerSchemaKey{kind, name}] = PropertyDefinition{Name: name, Owner: kind, Type: scalarKind, Cardinality: ScalarCardinality}
+		}
+		if op.Kind == Set || op.Kind == Add || op.Kind == Remove {
+			op.Value = indScalar(t, raw["value"])
+			op.ValueID = g.values
+			g.values++
+			define(op.Name, op.Value)
+		}
+		ops = append(ops, op)
+		if properties, ok := raw["properties"].(map[string]any); ok {
+			for key, value := range properties {
+				s := indScalar(t, value)
+				define(key, s)
+				ops = append(ops, Operation{Kind: Set, Owner: owner, Life: life, Scope: op.Scope, Name: key, Value: s, ValueID: g.values})
+				g.values++
+			}
+		}
+		if labels, ok := raw["labels"].([]any); ok {
+			for _, label := range labels {
+				ops = append(ops, Operation{Kind: AddLabel, Owner: owner, Life: life, Scope: op.Scope, Name: indText(label)})
+			}
+		}
+	}
+	return ops
+}
+func (g *indGraphAdapter) projection(t testing.TB, v *fixtureView, raw map[string]any) map[string]any {
+	t.Helper()
+	mode := Effective
+	if raw["mode"] == "declared" {
+		mode = Declared
+	}
+	actual := map[string]any{"nodes": map[string]any{}, "edges": map[string]any{}}
+	for id := range v.entities {
+		p, err := Project(t.Context(), v, id, indPosition(t, v.axis, raw["coordinate"]), mode, Limits{})
+		if err != nil {
+			t.Fatal(err)
+		}
+		if !p.Active {
+			continue
+		}
+		props := map[string]any{}
+		for _, property := range p.Properties {
+			if property.Cardinality == SetCardinality {
+				members := []any{}
+				for _, value := range property.Members {
+					members = append(members, scalarJSON(value))
+				}
+				props[property.Name] = members
+			} else {
+				props[property.Name] = scalarJSON(property.Scalar)
+			}
+		}
+		row := map[string]any{"life": uint64(p.Life), "properties": props}
+		if p.Record.Interpretation != "" {
+			row["interpretation"] = string(p.Record.Interpretation)
+		}
+		if p.Record.TemporalRole != "" {
+			row["temporal_role"] = string(p.Record.TemporalRole)
+		}
+		if p.Record.Kind == Node {
+			labels := p.Labels
+			if labels == nil {
+				labels = []string{}
+			}
+			row["labels"] = labels
+			actual["nodes"].(map[string]any)[g.names[id]] = row
+		} else {
+			row["source"] = g.names[p.Record.Source]
+			row["target"] = g.names[p.Record.Target]
+			row["type"] = p.Record.Type
+			if indBool(raw["lifecycle_status"], false) {
+				statuses := []any{}
+				for _, s := range p.Endpoints {
+					var activeLife, boundLife any
+					if s.Active {
+						activeLife = uint64(s.Life)
+					}
+					if s.BoundLife != 0 {
+						boundLife = uint64(s.BoundLife)
+					}
+					statuses = append(statuses, map[string]any{"identity": g.names[s.ID], "exists": true, "active_life": activeLife, "bound_life": boundLife, "bound_life_active": s.Active && s.Life == s.BoundLife})
+				}
+				row["endpoint_status"] = statuses
+				mode := "life_bound"
+				if p.Record.Mode == IdentityReference {
+					mode = "identity_reference"
+				}
+				row["reference_mode"] = mode
+			}
+			actual["edges"].(map[string]any)[g.names[id]] = row
+		}
+	}
+	return actual
+}
+func indGraphCase(t *testing.T, c map[string]any, removeMissingMetadata bool) {
+	t.Helper()
+	g := indGraph(t, c)
+	views := map[string]*fixtureView{}
+	for i, raw := range indList(c["steps"]) {
+		step := indObj(raw)
+		ops := g.operations(t, indList(step["operations"]))
+		rev, _ := state.NewRevision(uint64(i+1), uint64(i+101))
+		d, err := Plan(t.Context(), g.view, ops, rev, Limits{})
+		if err != nil {
+			t.Fatal(err)
+		}
+		v := g.view.clone()
+		v.install(t, d)
+		v.id[0]++
+		g.view = v
+		views[indText(step["snapshot"])] = v.clone()
+	}
+	for _, raw := range indList(c["reads"]) {
+		read := indObj(raw)
+		want := read["expected"]
+		if removeMissingMetadata {
+			for _, bucket := range []string{"nodes", "edges"} {
+				for _, row := range indObj(indObj(want)[bucket]) {
+					delete(indObj(row), "interpretation")
+					delete(indObj(row), "temporal_role")
+				}
+			}
+		}
+		indEqual(t, want, g.projection(t, views[indText(read["snapshot"])], read))
+	}
+	if errorsRaw, ok := c["failures"].([]any); ok {
+		for _, raw := range errorsRaw {
+			failure := indObj(raw)
+			code := indText(failure["expected_error"])
+			if code == "GRAPH_MISMATCH" {
+				continue
+			} // Operation carries no graph-qualified reference. Ledger marks whole case integration-missing.
+			g.view = views[indText(failure["base_snapshot"])].clone()
+			ops := g.operations(t, indList(failure["operations"]))
+			if code == "AXIS_MISMATCH" {
+				other := g.view.axis.Descriptor()
+				other.ID[0] ^= 0xff
+				a, err := temporal.NewAxis(other, temporal.Limits{})
+				if err != nil {
+					t.Fatal(err)
+				}
+				ops[0].Scope = indSpan(t, a, 0, 1, true, false)
+			}
+			rev, _ := state.NewRevision(999, 999)
+			d, err := Plan(t.Context(), g.view, ops, rev, Limits{})
+			want := map[string]error{"LIFECYCLE_OVERLAP": ErrLifecycleOverlap, "LIFE_EXISTS": ErrAlreadyExists, "NOT_FOUND": ErrNotFound, "OWNER_VALIDITY": ErrOwnerValidity, "AXIS_MISMATCH": temporal.ErrAxisMismatch, "TYPE_MISMATCH": ErrTypeMismatch}[code]
+			if !errors.Is(err, want) {
+				t.Fatalf("failure %s want %v got %v", code, want, err)
+			}
+			if !reflect.DeepEqual(d, Delta{}) {
+				t.Fatal("failed delta not empty", d)
+			}
+			// A prior tentative Set must not mutate either the base snapshot or
+			// another retained earlier view when the later operation fails.
+			for _, raw := range indList(c["reads"]) {
+				read := indObj(raw)
+				indEqual(t, read["expected"], g.projection(t, views[indText(read["snapshot"])], read))
+			}
+		}
+	}
+}
