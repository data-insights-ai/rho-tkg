+package graphstate
+
+// Test-only differential adapter in a SHA-pinned COPY. No production edits.
+// Expected answers come from the independent versioned JSON, never recomputation
+// through production Plan/Project. Existing fixtureView supplies test storage.
+
+import (
+	"bytes"
+	"crypto/sha256"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"math/big"
+	"os"
+	"reflect"
+	"strconv"
+	"strings"
+	"testing"
+
+	"github.com/data-insights-ai/rho-tkg/v5/internal/state"
+	"github.com/data-insights-ai/rho-tkg/v5/pkg/temporal"
+)
+
+const independentCorpus = "testdata/revised-acceptance-v1.json"
+
+func indDecode(t testing.TB, data []byte) any {
+	t.Helper()
+	d := json.NewDecoder(bytes.NewReader(data))
+	d.UseNumber()
+	var out any
+	if err := d.Decode(&out); err != nil {
+		t.Fatal(err)
+	}
+	return out
+}
+func indObj(x any) map[string]any { return x.(map[string]any) }
+func indList(x any) []any         { return x.([]any) }
+func indText(x any) string        { return fmt.Sprint(x) }
+func indBool(x any, fallback bool) bool {
+	if x == nil {
+		return fallback
+	}
+	return x.(bool)
+}
+func indEqual(t testing.TB, want, got any) {
+	t.Helper()
+	w, err := json.Marshal(want)
+	if err != nil {
+		t.Fatal(err)
+	}
+	g, err := json.Marshal(got)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if !bytes.Equal(w, g) {
+		t.Fatalf("golden divergence\nwant %s\ngot  %s", w, g)
+	}
+}
+func indAxis(t testing.TB, raw any) temporal.Axis {
+	t.Helper()
+	d := indObj(raw)
+	hash := sha256.Sum256([]byte(indText(d["identity"])))
+	var id temporal.AxisID
+	copy(id[:], hash[:16])
+	profile := map[string]temporal.Profile{"Q": temporal.ProfileRationalQ, "Z": temporal.ProfileIntegerZ, "QN": temporal.ProfileLexicographicQN}[indText(d["profile"])]
+	a, err := temporal.NewAxis(temporal.AxisDescriptor{ID: id, Profile: profile, Version: 1, Reference: indText(d["reference"]), CanonicalUnit: indText(d["unit"])}, temporal.Limits{})
+	if err != nil {
+		t.Fatal(err)
+	}
+	return a
+}
+func indPosition(t testing.TB, a temporal.Axis, raw any) temporal.Position {
+	t.Helper()
+	var p temporal.Position
+	var err error
+	switch a.Descriptor().Profile {
+	case temporal.ProfileIntegerZ:
+		n, e := temporal.ParseInteger(indText(raw), temporal.Limits{})
+		if e != nil {
+			t.Fatal(e)
+		}
+		p, err = temporal.IntegerPosition(a, n)
+	case temporal.ProfileRationalQ:
+		r, e := temporal.ParseRational(indText(raw), temporal.Limits{})
+		if e != nil {
+			t.Fatal(e)
+		}
+		p, err = temporal.RationalPosition(a, r)
+	case temporal.ProfileLexicographicQN:
+		v := indList(raw)
+		r, e := temporal.ParseRational(indText(v[0]), temporal.Limits{})
+		if e != nil {
+			t.Fatal(e)
+		}
+		m, e := temporal.ParseInteger(indText(v[1]), temporal.Limits{})
+		if e != nil {
+			t.Fatal(e)
+		}
+		p, err = temporal.LexPosition(a, r, m)
+	}
+	if err != nil {
+		t.Fatal(err)
+	}
+	return p
+}
+func indSpan(t testing.TB, a temporal.Axis, lo, hi any, lc, hc bool) temporal.Scope {
+	t.Helper()
+	var lower, upper temporal.Bound
+	var err error
+	if indText(lo) == "-inf" {
+		lower = temporal.NegativeInfinity()
+	} else {
+		lower, err = temporal.FiniteBound(indPosition(t, a, lo), lc)
+		if err != nil {
+			t.Fatal(err)
+		}
+	}
+	if indText(hi) == "+inf" {
+		upper = temporal.PositiveInfinity()
+	} else {
+		upper, err = temporal.FiniteBound(indPosition(t, a, hi), hc)
+		if err != nil {
+			t.Fatal(err)
+		}
+	}
+	s, err := temporal.Span(a, lower, upper, temporal.Limits{})
+	if err != nil {
+		t.Fatal(err)
+	}
+	return s
+}
+func indScope(t testing.TB, raw any) temporal.Scope {
+	t.Helper()
+	d := indObj(raw)
+	a := indAxis(t, d["axis"])
+	parts := []temporal.Scope{}
+	for _, part := range indList(d["pieces"]) {
+		p := indObj(part)
+		parts = append(parts, indSpan(t, a, p["lower"], p["upper"], p["lower_closed"].(bool), p["upper_closed"].(bool)))
+	}
+	s, err := temporal.Region(a, parts, temporal.Limits{})
+	if err != nil {
+		t.Fatal(err)
+	}
+	return s
+}
+func indOpScope(t testing.TB, a temporal.Axis, raw map[string]any) temporal.Scope {
+	t.Helper()
+	if d, ok := raw["valid"].(map[string]any); ok {
+		parts := []temporal.Scope{}
+		for _, part := range indList(d["pieces"]) {
+			p := indObj(part)
+			parts = append(parts, indSpan(t, a, p["lower"], p["upper"], indBool(p["lower_closed"], true), indBool(p["upper_closed"], false)))
+		}
+		s, e := temporal.Region(a, parts, temporal.Limits{})
+		if e != nil {
+			t.Fatal(e)
+		}
+		return s
+	}
+	pair := indList(raw["valid"])
+	return indSpan(t, a, pair[0], pair[1], indBool(raw["lower_closed"], true), indBool(raw["upper_closed"], false))
+}
+func indScalar(t testing.TB, v any) Scalar {
+	t.Helper()
+	switch value := v.(type) {
+	case nil:
+		return Null()
+	case string:
+		return String(value)
+	case bool:
+		return Bool(value)
+	case json.Number:
+		n, e := strconv.ParseInt(string(value), 10, 64)
+		if e != nil {
+			t.Fatal("no rational/opaque fallback", e)
+		}
+		return I64(n)
+	default:
+		t.Fatal("required typed graph scalar is unavailable; refusing string fallback", reflect.TypeOf(v))
+		return Scalar{}
+	}
+}
