+func TestDeclarationLimitsMetadataLedgerBounds(t *testing.T) {
+	defaults := DefaultLimits()
+	if defaults.MaxInputMetadataBytes != 1<<20 {
+		t.Fatal("finite concrete default", defaults.MaxInputMetadataBytes)
