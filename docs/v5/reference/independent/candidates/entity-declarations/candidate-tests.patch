+func TestIndependentLongNamesAndDependenciesExactByteLimits(t *testing.T) {
+	for _, target := range []string{"MaxReadBytes", "MaxDeltaBytes"} {
+		t.Run(target, func(t *testing.T) {
+			v := newFixtureView(t)
+			name := strings.Repeat("key-", 300)
+			v.defs[ownerSchemaKey{Node, name}] = PropertyDefinition{Name: name, Owner: Node, Type: ScalarI64, Cardinality: ScalarCardinality}
+			op := []Operation{{Kind: CreateNode, Owner: 1, Life: 1, Scope: testSpan(t, v.axis, 0, 10)}, {Kind: Set, Owner: 1, Life: 1, Scope: testSpan(t, v.axis, 0, 10), Name: name, Value: I64(7), ValueID: 1}}
+			r, _ := state.NewRevision(1, 1)
+			run := func(cap int) (Delta, error) {
+				l := DefaultLimits()
+				l.MaxNameBytes = 4096
+				if target == "MaxReadBytes" {
+					l.MaxReadBytes = cap
+				} else {
+					l.MaxDeltaBytes = cap
+				}
+				return Plan(t.Context(), v, op, r, l)
+			}
+			lo, hi := 1, 64<<20
+			for lo < hi {
+				mid := lo + (hi-lo)/2
+				_, err := run(mid)
+				if err == nil {
+					hi = mid
+				} else if errors.Is(err, ErrResourceLimit) || errors.Is(err, temporal.ErrResourceLimit) || errors.Is(err, state.ErrResourceLimit) {
+					lo = mid + 1
+				} else {
+					t.Fatal(err)
+				}
+			}
+			d, err := run(lo)
+			if err != nil {
+				t.Fatal("exact-fit", err)
+			}
+			t.Log(target, "minimum fitting", lo, "deps", len(d.Dependencies))
+			d, err = run(lo - 1)
+			if !errors.Is(err, ErrResourceLimit) && !errors.Is(err, temporal.ErrResourceLimit) && !errors.Is(err, state.ErrResourceLimit) {
+				t.Fatal("one-byte lower did not reject", err)
+			}
+			if len(d.Patches)+len(d.Entities)+len(d.Values)+len(d.Lives) != 0 {
+				t.Fatal("failure returned partial delta")
+			}
+		})
+	}
+}
