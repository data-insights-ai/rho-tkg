+func TestDeclarationMetadataValidationAndOwnerParity(t *testing.T) {
+	for _, owner := range []EntityID{1, 3} {
+		for _, test := range []struct {
+			name string
+			i    Interpretation
+			r    TemporalRole
+			want error
+		}{
+			{"unknown-interpretation", Interpretation("future-model"), TemporalRoleValidity, ErrUnsupported},
+			{"unknown-role", InterpretationState, TemporalRole("future-role"), ErrUnsupported},
+			{"wrong-role-in-interpretation", Interpretation("validity"), TemporalRoleValidity, ErrUnsupported},
+			{"wrong-interpretation-in-role", InterpretationState, TemporalRole("state"), ErrUnsupported},
+			{"malformed-interpretation", Interpretation("\xff"), TemporalRoleValidity, ErrInvalidInput},
+			{"malformed-role", InterpretationState, TemporalRole("\xff"), ErrInvalidInput},
+			{"whitespace-interpretation", Interpretation(" state"), TemporalRoleValidity, ErrInvalidInput},
+			{"whitespace-role", InterpretationState, TemporalRole("validity "), ErrInvalidInput},
+			{"oversized-interpretation", Interpretation(strings.Repeat("x", 257)), TemporalRoleValidity, ErrResourceLimit},
+			{"oversized-role", InterpretationState, TemporalRole(strings.Repeat("x", 257)), ErrResourceLimit},
+		} {
+			t.Run(test.name+"/"+map[EntityID]string{1: "node", 3: "rel"}[owner], func(t *testing.T) {
+				v := declarationFixture(t)
+				before := v.clone()
+				record := v.entities[owner]
+				record.ID = 10
+				record.Interpretation = test.i
+				record.TemporalRole = test.r
+				kind := CreateNode
+				if owner == 3 {
+					kind = CreateRelationship
+				}
+				d, err := Plan(t.Context(), v, []Operation{{Kind: kind, Owner: 10, Life: 1, Scope: testSpan(t, v.axis, 0, 10), Record: record}}, declarationRevision(t), Limits{})
+				declarationEmptyDelta(t, d, err, test.want)
+				declarationSameViews(t, before, v)
+			})
+		}
+	}
+}
