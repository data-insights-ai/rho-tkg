+func indNativeKnowledge(t *testing.T, c map[string]any) {
+	t.Helper()
+	support, window := indScope(t, c["support"]), indScope(t, c["window"])
+	var k temporal.PointKnowledge
+	var err error
+	if c["knowledge_kind"] == nil {
+		k, err = temporal.HardPointKnowledge(support, temporal.Limits{})
+	} else {
+		switch indText(c["knowledge_kind"]) {
+		case "confidence_95_percent", "confidence_100_percent":
+			level := temporal.RationalInt64(1)
+			if c["knowledge_kind"] == "confidence_95_percent" {
+				level, _ = temporal.ParseRational("19/20", temporal.Limits{})
+			}
+			k, err = temporal.ConfidencePointKnowledge(support, level, temporal.Limits{})
+		case "nominal":
+			k, err = temporal.NominalPointKnowledge(indPosition(t, support.Axis(), "12"), temporal.Limits{})
+		case "unspecified":
+			k, err = temporal.UnspecifiedPointKnowledge(support.Axis(), temporal.Limits{})
+		case "opaque_correlated_constraint":
+			d, e := temporal.PreserveOpaqueDescriptor(temporal.OpaqueDescriptorSpec{ID: temporal.DescriptorID{1}, Type: "shared-constraint", SchemaVersion: 9, Correlation: temporal.CorrelationID{1}, Payload: []byte("opaque")}, temporal.Limits{})
+			if e != nil {
+				t.Fatal(e)
+			}
+			k, err = temporal.OpaquePointKnowledge(support.Axis(), d, temporal.Limits{})
+		}
+	}
+	if err != nil {
+		t.Fatal(err)
+	}
+	for name, fn := range map[string]func(temporal.Scope, temporal.Limits) (temporal.SupportResult, error){"possible": k.PossibleIn, "definite": k.DefiniteIn} {
+		got, err := fn(window, temporal.Limits{})
+		if c["expected_error"] != nil {
+			if !errors.Is(err, temporal.ErrUnsupportedPredicate) {
+				t.Fatal(err)
+			}
+			continue
+		}
+		if err != nil {
+			t.Fatal(err)
+		}
+		consistency := "consistent"
+		if got.Consistency == temporal.KnowledgeInconsistent {
+			consistency = "inconsistent"
+		}
+		indEqual(t, indObj(c["expected"])[name], map[string]any{"holds": got.Holds, "consistency": consistency})
+	}
+}
+func indOpaquePrimitive(t *testing.T, c map[string]any) {
+	t.Helper()
+	for _, raw := range indList(c["steps"]) {
+		step := indObj(raw)
+		for _, r := range indList(step["operations"]) {
+			op := indObj(r)
+			var payload any
+			if props, ok := op["properties"].(map[string]any); ok {
+				payload = props["descriptor"]
+			} else {
+				payload = op["value"]
+			}
+			if payload == nil {
+				continue
+			}
+			original, err := json.Marshal(payload)
+			if err != nil {
+				t.Fatal(err)
+			}
+			correlation := temporal.CorrelationID{}
+			if strings.HasPrefix(indText(c["id"]), "E06") {
+				correlation[0] = 1
+			}
+			spec := temporal.OpaqueDescriptorSpec{ID: temporal.DescriptorID{1}, Type: indText(c["id"]), SchemaVersion: 99, Correlation: correlation, Payload: original}
+			d, err := temporal.PreserveOpaqueDescriptor(spec, temporal.Limits{})
+			if err != nil {
+				t.Fatal(err)
+			}
+			wire, err := temporal.AppendOpaqueDescriptor(nil, d, temporal.Limits{})
+			if err != nil {
+				t.Fatal(err)
+			}
+			decoded, err := temporal.DecodeOpaqueDescriptor(wire, temporal.Limits{})
+			if err != nil {
+				t.Fatal(err)
+			}
+			if decoded.SupportLevel() != temporal.DescriptorPreservationOnly || decoded.Spec().SchemaVersion != 99 || decoded.Spec().Correlation != correlation || !bytes.Equal(decoded.Spec().Payload, original) {
+				t.Fatal("native opaque preservation diverged")
+			}
+		}
+	}
+}
