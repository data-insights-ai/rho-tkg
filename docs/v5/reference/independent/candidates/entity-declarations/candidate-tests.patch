+func indCell(t testing.TB, c state.Cell, values map[uint64]any) map[string]any {
+	t.Helper()
+	var revision, provenance, value any
+	if c.Revision().ID() != 0 {
+		revision = fmt.Sprintf("r%d", c.Revision().ID())
+	}
+	if c.Revision().Provenance() != 0 {
+		provenance = fmt.Sprintf("p%d", c.Revision().Provenance())
+	}
+	if c.Present() && !c.Value().IsNull() {
+		value = values[c.Value().ID()]
+	}
+	return map[string]any{"present": c.Present(), "value": value, "revision": revision, "provenance": provenance}
+}
+func indComponentCase(t *testing.T, c map[string]any) {
+	t.Helper()
+	a := indAxis(t, c["axis"])
+	s, err := state.New(a, state.Limits{})
+	if err != nil {
+		t.Fatal(err)
+	}
+	values := map[uint64]any{}
+	names := map[string]string{}
+	revisions, provenances, payloads := map[string]uint64{}, map[string]uint64{}, map[string]uint64{}
+	snapshots := []state.State{s}
+	results := []state.Result{}
+	for _, raw := range indList(c["operations"]) {
+		op := indObj(raw)
+		cell := indObj(op["cell"])
+		rname, pname := indText(cell["revision"]), indText(cell["provenance"])
+		// Preserve identity through a deterministic adapter dictionary, never a clock.
+		id := revisions[rname]
+		if id == 0 {
+			id = uint64(len(revisions) + 1)
+			revisions[rname] = id
+			names[fmt.Sprintf("r%d", id)] = rname
+		}
+		pid := provenances[pname]
+		if pid == 0 {
+			pid = uint64(len(provenances) + 1)
+			provenances[pname] = pid
+			names[fmt.Sprintf("p%d", pid)] = pname
+		}
+		r, _ := state.NewRevision(id, pid)
+		var result state.Result
+		if cell["present"].(bool) {
+			value := state.Null()
+			if cell["value"] != nil {
+				encoded, _ := json.Marshal(cell["value"])
+				key := string(encoded)
+				vid := payloads[key]
+				if vid == 0 {
+					vid = uint64(len(payloads) + 1000)
+					payloads[key] = vid
+					values[vid] = cell["value"]
+				}
+				value, err = state.NewValueRef(vid, 0)
+				if err != nil {
+					t.Fatal(err)
+				}
+			}
+			result, err = s.Set(indScope(t, op["scope"]), value, r, state.Limits{})
+		} else {
+			result, err = s.Unset(indScope(t, op["scope"]), r, state.Limits{})
+		}
+		if err != nil {
+			t.Fatal(err)
+		}
+		s = result.State()
+		snapshots = append(snapshots, s)
+		results = append(results, result)
+	}
+	fullCellJSON := func(cell state.Cell) any {
+		got := indCell(t, cell, values)
+		for _, key := range []string{"revision", "provenance"} {
+			if got[key] != nil {
+				got[key] = names[got[key].(string)]
+			}
+		}
+		return got
+	}
+	cellJSON := func(s state.State, p any) any {
+		cell, err := s.At(indPosition(t, a, p), state.Limits{})
+		if err != nil {
+			t.Fatal(err)
+		}
+		return fullCellJSON(cell)
+	}
+	expected := indObj(c["expected"])
+	if probes, ok := c["probes"].([]any); ok {
+		for name, index := range map[string]int{"old": 1, "corrected": 2, "retracted": 3} {
+			got := []any{}
+			for _, p := range probes {
+				got = append(got, cellJSON(snapshots[index], p))
+			}
+			indEqual(t, expected[name], got)
+		}
+	} else {
+		for name, index := range map[string]int{"null": 1, "corrected_null": 2, "retracted": 4, "never_asserted": 0} {
+			indEqual(t, expected[name], cellJSON(snapshots[index], json.Number("5")))
+		}
+		indEqual(t, expected["new_revision_change_count"], len(results[1].Changes()))
+		indEqual(t, expected["replay_change_count"], len(results[2].Changes()))
+	}
+	if raw, ok := c["changes"].([]any); ok {
+		actual := results[1].Changes()
+		if len(raw) != len(actual) {
+			t.Fatal("CDC golden cardinality", len(raw), len(actual))
+		}
+		for i, entry := range raw {
+			golden := indObj(entry)
+			same, err := actual[i].Scope().SameSupport(indScope(t, golden["scope"]), temporal.Limits{})
+			if err != nil || !same {
+				t.Fatal("CDC exact support", err)
+			}
+			indEqual(t, golden["before"], fullCellJSON(actual[i].Before()))
+			indEqual(t, golden["after"], fullCellJSON(actual[i].After()))
+		}
+	}
+}
