+func TestDeclarationReaderValidationAndNoPartialProjection(t *testing.T) {
+	for _, owner := range []EntityID{1, 3} {
+		for _, test := range []struct {
+			name   string
+			mutate func(*EntityRecord)
+			want   error
+		}{
+			{"unknown", func(r *EntityRecord) { r.Interpretation = Interpretation("future") }, ErrUnsupported},
+			{"malformed", func(r *EntityRecord) { r.TemporalRole = TemporalRole("\xff") }, ErrContradictoryRead},
+			{"oversized", func(r *EntityRecord) { r.TemporalRole = TemporalRole(strings.Repeat("x", 257)) }, ErrResourceLimit},
+		} {
+			t.Run(test.name+"/"+map[EntityID]string{1: "node", 3: "rel"}[owner], func(t *testing.T) {
+				v := declarationFixture(t)
+				record := v.entities[owner]
+				test.mutate(&record)
+				bad := &declarationBadRead{fixtureView: v, owner: owner, record: record, found: true}
+				p, err := Project(t.Context(), bad, owner, testPosition(t, v.axis, 5), Effective, Limits{})
+				if !errors.Is(err, test.want) || !reflect.DeepEqual(p, Projection{}) {
+					t.Fatalf("reader projection did not fail closed: %v empty=%v", err, reflect.DeepEqual(p, Projection{}))
+				}
+				d, err := Plan(t.Context(), bad, []Operation{{Kind: Close, Owner: owner, Life: 1, Scope: testSpan(t, v.axis, 3, 7)}}, declarationRevision(t), Limits{})
+				declarationEmptyDelta(t, d, err, test.want)
+			})
+		}
+	}
