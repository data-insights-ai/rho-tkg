+func TestIndependentRevisedCorpus(t *testing.T) {
+	data, err := os.ReadFile(independentCorpus)
+	if err != nil {
+		t.Fatal(err)
+	}
+	document := indObj(indDecode(t, data))
+	cases := indList(document["cases"])
+	if len(cases) != 42 {
+		t.Fatal("42-case coverage must not shrink", len(cases))
+	}
+	for _, raw := range cases {
+		c := indObj(raw)
+		id := indText(c["id"])
+		t.Run(id, func(t *testing.T) {
+			status, detail := "supported/pass", "Exact independent JSON golden consumed."
+			defer func() {
+				if t.Failed() && status == "supported/pass" {
+					status = "concrete_failing"
+				}
+				record, _ := json.Marshal(map[string]any{"id": id, "status": status, "detail": detail})
+				t.Log("INDEPENDENT_CASE " + string(record))
+			}()
+			switch {
+			case strings.HasPrefix(id, "E03-E08-support-"):
+				expected := indObj(c["expected"])
+				input := indObj(c["input"])
+				a := indAxis(t, c["axis"])
+				for name, shape := range map[string][2]bool{"open_interval": {false, false}, "half_open": {true, false}, "point": {true, true}} {
+					upper := input["upper"]
+					if name == "point" {
+						upper = input["lower"]
+					}
+					got := indSpan(t, a, input["lower"], upper, shape[0], shape[1])
+					same, err := got.SameSupport(indScope(t, expected[name]), temporal.Limits{})
+					if err != nil || !same {
+						t.Fatal(name, err)
+					}
+				}
+				point := indSpan(t, a, input["lower"], input["lower"], true, true)
+				half := indSpan(t, a, input["lower"], input["upper"], true, false)
+				equal, err := point.SameSupport(half, temporal.Limits{})
+				if err != nil {
+					t.Fatal(err)
+				}
+				indEqual(t, expected["point_equals_half_open"], equal)
+			case id == "E02-components-correction-retraction" || id == "SEM12-null-revision-replay":
+				indComponentCase(t, c)
+			case id == "budget-tight-Z-replay-no-transient-successor":
+				a := indAxis(t, c["axis"])
+				l := state.Limits{Temporal: temporal.Limits{MaxMagnitudeBits: 2}}
+				s, err := state.New(a, l)
+				if err != nil {
+					t.Fatal(err)
+				}
+				r, _ := state.NewRevision(1, 1)
+				v, _ := state.NewValueRef(1, 0)
+				first, err := s.Set(indScope(t, c["initial_scope"]), v, r, l)
+				if err != nil {
+					t.Fatal(err)
+				}
+				replay, err := first.State().Set(indScope(t, c["mutation_scope"]), v, r, l)
+				if err != nil {
+					t.Fatal(err)
+				}
+				if len(replay.Changes()) != 0 {
+					t.Fatal("replay CDC")
+				}
+				same, err := replay.State().Pieces()[0].Scope().SameSupport(indScope(t, indObj(c["expected"])["scope"]), l.Temporal)
+				if err != nil || !same {
+					t.Fatal(err)
+				}
+			case indText(c["kind"]) == "knowledge":
+				indNativeKnowledge(t, c)
+				detail = "Native temporal knowledge path passes; graph PointKnowledge scalar integration is unavailable and separately reported."
+			case id == "E09-source-history-derived-fraction":
+				for _, raw := range indList(c["source_regions"]) {
+					s := indScope(t, raw)
+					wire, err := temporal.AppendScope(nil, s, temporal.Limits{})
+					if err != nil {
+						t.Fatal(err)
+					}
+					decoded, err := temporal.DecodeScope(wire, s.Axis(), temporal.Limits{})
+					if err != nil {
+						t.Fatal(err)
+					}
+					same, err := decoded.SameSupport(s, temporal.Limits{})
+					if err != nil || !same {
+						t.Fatal(err)
+					}
+				}
+				for _, field := range []string{"supplied_result", "supplied_shifted_result"} {
+					s := indScope(t, c[field])
+					wire, err := temporal.AppendScope(nil, s, temporal.Limits{})
+					if err != nil {
+						t.Fatal(err)
+					}
+					decoded, err := temporal.DecodeScope(wire, s.Axis(), temporal.Limits{})
+					if err != nil {
+						t.Fatal(err)
+					}
+					same, err := decoded.SameSupport(s, temporal.Limits{})
+					if err != nil || !same {
+						t.Fatal(err)
+					}
+				}
+				detail = "Native supplied-result scope preservation passes; no sigma join or rational scalar integration inferred."
+			case id == "E04-exact-nearby-values":
+				values := indList(c["input"])
+				a, err := temporal.ParseRational(indText(values[0]), temporal.Limits{})
+				if err != nil {
+					t.Fatal(err)
+				}
+				b, err := temporal.ParseRational(indText(values[1]), temporal.Limits{})
+				if err != nil {
+					t.Fatal(err)
+				}
+				order, err := a.Compare(b, temporal.Limits{})
+				if err != nil || order != temporal.Less {
+					t.Fatal(err)
+				}
+				expected := indObj(c["expected"])
+				indEqual(t, expected["equal"], order == temporal.Equal)
+				ar, ok := new(big.Rat).SetString(a.String())
+				if !ok {
+					t.Fatal(a.String())
+				}
+				br, ok := new(big.Rat).SetString(b.String())
+				if !ok {
+					t.Fatal(b.String())
+				}
+				indEqual(t, expected["difference_seconds"], new(big.Rat).Sub(br, ar).RatString())
+				axis, err := temporal.NewAxis(temporal.AxisDescriptor{ID: temporal.AxisID{4}, Profile: temporal.ProfileRationalQ, Version: 1, Reference: "independent-E04-explicit-seconds", CanonicalUnit: "second"}, temporal.Limits{})
+				if err != nil {
+					t.Fatal(err)
+				}
+				for _, v := range []temporal.Rational{a, b} {
+					position, err := temporal.RationalPosition(axis, v)
+					if err != nil {
+						t.Fatal(err)
+					}
+					wire, err := temporal.AppendPosition(nil, position, temporal.Limits{})
+					if err != nil {
+						t.Fatal(err)
+					}
+					decoded, err := temporal.DecodePosition(wire, axis, temporal.Limits{})
+					if err != nil {
+						t.Fatal(err)
+					}
+					r, ok := decoded.Rational()
+					if !ok || r.String() != v.String() {
+						t.Fatal("exact source coordinate changed")
+					}
+				}
+				detail = "Native exact rational distinction passes; rounding operation and graph Rational scalar are not claimed."
+			case id == "axis-conflicting-definition-empty":
+				a, b := indAxis(t, c["left_axis"]), indAxis(t, c["right_axis"])
+				x, _ := temporal.Empty(a)
+				y, _ := temporal.Empty(b)
+				if _, err := x.SameSupport(y, temporal.Limits{}); !errors.Is(err, temporal.ErrAxisMismatch) {
+					t.Fatal(err)
+				}
+			case id == "strict-symbolic-placement-decline":
+				v := newFixtureView(t)
+				u, _ := temporal.Unplaced(v.axis)
+				r, _ := state.NewRevision(1, 1)
+				d, err := Plan(t.Context(), v, []Operation{{Kind: CreateNode, Owner: 1, Life: 1, Scope: u}}, r, Limits{})
+				if !errors.Is(err, ErrUnsupported) || len(d.Patches) != 0 {
+					t.Fatal(err)
+				}
+				detail = "Native Unplaced enforcement explicitly declines; opaque graph placement kind itself is not integrated."
+			case indText(c["kind"]) == "graph":
+				switch id {
+				case "E19-close-reopen-identity-reference", "E19-strict-life-bound-presence-correction", "SEM03-06-node-rel-property-history":
+					indGraphCase(t, c, false)
+				case "SEM14-16-endpoint-boundary":
+					status = "missing_required_integration"
+					detail = "Functional endpoint/axis failures pass, but operations do not carry graph-qualified references: GRAPH_MISMATCH expectation has no representable input."
+					indGraphCase(t, c, false)
+					t.Error(detail)
+				case "E01-event-multiplicity", "E01-E03-interpretation-independent-of-support-Z", "E07-causal-records":
+					detail = "Complete unchanged golden preserves supplied typed interpretation and native-axis role; no inference or semantic evaluation."
+					indGraphCase(t, c, false)
+				case "E02-disjoint-native-region":
+					detail = "Full unchanged golden through owner-qualified same-name node/relationship property schemas; disjoint region correction/retraction and historical reads."
+					indGraphCase(t, c, false)
+				default:
+					status = "missing_required_integration"
+					detail = "Native OpaqueDescriptor primitive passes raw payload/version/correlation; graph Scalar has no descriptor metadata/kind. E14 ScopeValue supports scope only, not its whole descriptor/correction metadata. No string fallback."
+					indOpaquePrimitive(t, c)
+					t.Error(detail)
+				}
+			case indText(c["kind"]) == "unit_mapping" || indText(c["kind"]) == "codec_contract":
+				status = "missing_required_integration"
+				detail = "No pkg/types.Instant/default-axis/unit-mapping adapter in this pinned module. Native exact rational primitive is separately checked; mathematical helper arithmetic would not prove this API."
+				t.Error(detail)
+			default:
+				status = "model_only_policy_or_declarative_obligation"
+				detail = "Oracle JSON accounting, import provenance, or transaction/deduplication obligation; no equivalent implementation path exists in this slice. Explicitly unexecuted, never a skipped pass."
+			}
+		})
+	}
+}
