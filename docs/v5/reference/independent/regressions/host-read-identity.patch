+func TestReadIdentityBoundsAndOverflow(t *testing.T) {
+	n := newNetwork(t)
+	n.drop[2], n.drop[3] = true, true
+	packets := []replica.Packet{}
+	ids := map[ReadID]bool{}
+	for range 32 {
+		event, err := n.hosts[1].Read(Query{Kind: Current})
+		if err != nil || event.ID == (ReadID{}) || ids[event.ID] || len(event.Replies) != 0 {
+			t.Fatalf("admission identity: %+v %v", event, err)
+		}
+		ids[event.ID] = true
+		packets = append(packets, event.Packets...)
+	}
+	event, err := n.hosts[1].Read(Query{Kind: Current})
+	if !errors.Is(err, replica.ErrLimit) || event.ID != (ReadID{}) {
+		t.Fatalf("unbounded new operation: %+v %v", event, err)
+	}
+	delete(n.drop, 2)
+	delete(n.drop, 3)
+	n.run(t, 1, Event{Packets: packets}, nil)
+	delivered := map[ReadID]bool{}
+	for _, reply := range n.replies[1] {
+		if reply.Err != nil || !ids[reply.ID] || delivered[reply.ID] {
+			t.Fatalf("unbound/duplicate completion: %+v", reply)
+		}
+		delivered[reply.ID] = true
+	}
+	if len(delivered) != 32 {
+		t.Fatalf("lost completions: %d", len(delivered))
+	}
+	n.hosts[1].readSequence = math.MaxUint64 - 1
+	last, lastErr := n.hosts[1].Read(Query{Kind: Current})
+	if lastErr != nil || last.ID.Sequence != math.MaxUint64 {
+		t.Fatal("last nonoverflowing identity rejected", last, lastErr)
+	}
+	n.run(t, 1, last, nil)
+	event, err = n.hosts[1].Read(Query{Kind: Current})
+	if !errors.Is(err, ErrLimit) || event.ID != (ReadID{}) {
+		t.Fatalf("sequence overflow: %+v %v", event, err)
+	}
+	var missing *Host
+	if event, err = missing.Read(Query{Kind: Current}); !errors.Is(err, ErrInvalid) || event.ID != (ReadID{}) {
+		t.Fatal(event, err)
+	}
+}
+
+func TestReadIdentityRestartRejectsGenuineDelayedResponse(t *testing.T) {
+	n := newNetwork(t)
+	first, err := n.hosts[1].Read(Query{Kind: Current})
+	if err != nil {
+		t.Fatal(err)
+	}
+	delayed := []replica.Packet{}
+	for _, packet := range first.Packets {
+		if packet.To != 2 && packet.To != 3 {
+			continue
+		}
+		event, err := n.hosts[packet.To].Step(packet)
+		if err != nil {
+			t.Fatal(err)
+		}
+		for _, response := range event.Packets {
+			if response.To == 1 {
+				delayed = append(delayed, response)
+			}
+		}
+	}
+	if len(delayed) == 0 {
+		t.Fatal("no genuine old response")
+	}
+	n.reopen(t, 1)
+	n.elect(t, 1)
+	second, err := n.hosts[1].Read(Query{Kind: Current})
+	if err != nil {
+		t.Fatal(err)
+	}
+	if first.ID.Session == second.ID.Session || second.ID == (ReadID{}) {
+		t.Fatal("restart reused operation namespace")
+	}
+	for _, packet := range delayed {
+		event, err := n.hosts[1].Step(packet)
+		if err != nil {
+			t.Fatal(err)
+		}
+		for _, reply := range event.Replies {
+			if reply.ID == first.ID || reply.ID == second.ID {
+				t.Fatal("old response completed restarted operation", reply)
+			}
+		}
+	}
+	n.replies[1] = nil
+	n.run(t, 1, second, nil)
+	found := false
+	for _, reply := range n.replies[1] {
+		if reply.ID == second.ID {
+			if reply.Err != nil {
+				t.Fatal(reply.Err)
+			}
+			found = true
+		}
+	}
+	if !found {
+		t.Fatal("fresh restarted operation did not complete")
+	}
+}
+
+func TestReadEnvelopeCanonicalBoundsAndStaleIdentity(t *testing.T) {
+	n := newNetwork(t)
+	h := n.hosts[1]
+	initial := h.readSequence
+	if _, err := h.Read(Query{Kind: "invalid"}); !errors.Is(err, ErrInvalid) || h.readSequence != initial {
+		t.Fatal("invalid input consumed operation", err)
+	}
+	n.read(t, 1, Query{Kind: Current})
+	var worst [16]byte
+	for i := range worst {
+		worst[i] = 255
+	}
+	request := readRequest{Version: 1, ID: ReadID{Session: worst, Sequence: math.MaxUint64}, Query: Query{Kind: Registration, TxID: string(make([]byte, 128))}}
+	wire, err := json.Marshal(request)
+	if err != nil || len(wire) > 1024 {
+		t.Fatalf("legal envelope exceeds driver bound: %d %v", len(wire), err)
+	}
+	// Negative-only unit guard checks: no fabricated read can yield Proof. Actual
+	// authority/restart regressions above use genuine Host-produced packets.
+	index := h.driver.Applied()
+	for _, change := range []func(*readRequest){func(r *readRequest) { r.Version = 2 }, func(r *readRequest) { r.ID.Session = [16]byte{} }, func(r *readRequest) { r.ID.Sequence = 0 }, func(r *readRequest) { r.ID.Sequence = h.readSequence + 1 }} {
+		bad := readRequest{Version: 1, ID: ReadID{Session: h.readSession, Sequence: h.readSequence}, Query: Query{Kind: Current}}
+		change(&bad)
+		b, _ := json.Marshal(bad)
+		event, err := h.event(replica.Output{Applied: index, Reads: []replica.ReadResult{{Index: index, Context: b}}}, nil)
+		if !errors.Is(err, ErrInvalid) || len(event.Replies) != 0 {
+			t.Fatal("unowned stale read minted authority", event, err)
+		}
+	}
+}
+
+func TestReadIdentityConstructorRejectsMalformedConfig(t *testing.T) {
+	if host, err := OpenHost(Config{}, nil, 1); !errors.Is(err, ErrInvalid) || host != nil {
+		t.Fatalf("malformed config admitted host: %v %v", host, err)
+	}
+}
