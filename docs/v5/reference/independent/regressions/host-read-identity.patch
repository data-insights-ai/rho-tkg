+// A second client asks the same question after a new leader acknowledged a
+// mutation. A held heartbeat reply for the first client's older read must not
+// satisfy the new client's request. Every held packet is produced by a real Host.
+func TestReadIdentityHeldOldReplyCannotCompleteLaterQuery(t *testing.T) {
+	n := newNetwork(t)
+	query := Query{Kind: Current}
+	first, err := n.hosts[1].Read(query)
+	if err != nil || len(first.Replies) != 0 || first.ID == (ReadID{}) {
+		t.Fatalf("first read fixture: %+v %v", first, err)
+	}
+	delayed := []replica.Packet{}
+	for _, packet := range first.Packets {
+		if packet.To != 2 && packet.To != 3 {
+			continue
+		}
+		event, err := n.hosts[packet.To].Step(packet)
+		if err != nil {
+			t.Fatal(err)
+		}
+		for _, response := range event.Packets {
+			if response.To == 1 {
+				delayed = append(delayed, response)
+			}
+		}
+	}
+	if len(delayed) == 0 {
+		t.Fatal("no genuine delayed first-read response")
+	}
+	n.drop[1] = true // Old leader remains paused; replicas2/3 elect another leader.
+	n.elect(t, 2)
+	mutation := tx("new-leader-write", 0, participant(0, 0, Effect{Key: "fresh", Value: 7}))
+	p, e := Local(mutation)
+	n.submit(t, 2, p, e)
+	acknowledged := n.read(t, 2, Query{Kind: Decided, TxID: mutation.ID})
+	if !acknowledged.View().Decision.Commit {
+		t.Fatal("new leader did not commit")
+	}
+	authoritativeNow := n.read(t, 2, query).View()
+	if authoritativeNow.State.Values["fresh"].Value != 7 {
+		t.Fatal("new-leader mutation missing")
+	}
+	// A distinct later read begins after that authoritative decision observation.
+	second, err := n.hosts[1].Read(query)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if len(second.Replies) != 0 {
+		t.Fatal("minority answered without a message")
+	}
+	if second.ID == (ReadID{}) || second.ID == first.ID {
+		t.Fatal("new operation reused first read identity")
+	}
+	completed, err := n.hosts[1].Step(delayed[0])
+	if err != nil {
+		t.Fatal(err)
+	}
+	firstCompletions := 0
+	for _, reply := range completed.Replies {
+		if reply.Query == query && reply.Err == nil {
+			view := reply.Proof.View()
+			if reply.ID == second.ID {
+				if value, exists := view.State.Values["fresh"]; !exists || value.Value != 7 {
+					t.Fatalf("new operation accepted earlier stale completion: %+v", view)
+				}
+			} else if reply.ID != first.ID {
+				t.Fatal("completion has no originating operation")
+			} else {
+				firstCompletions++
+				if len(view.State.Values) != 0 {
+					t.Fatal("first reply did not preserve pre-mutation observation", view)
+				}
+			}
+		}
+	}
+
+	if firstCompletions != 1 {
+		t.Fatalf("first operation completed %d times", firstCompletions)
+	}
+}
