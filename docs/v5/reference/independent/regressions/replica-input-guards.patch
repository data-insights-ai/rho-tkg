+func stepMessage(t *testing.T, d *Driver, m *pb.Message) (Output, error) {
+	t.Helper()
+	m.To = new(d.config.ID)
+	if m.GetFrom() == 0 {
+		m.From = new(uint64(2))
+	}
+	b, err := proto.Marshal(m)
+	if err != nil {
+		t.Fatal(err)
+	}
+	return d.Step(Packet{From: m.GetFrom(), To: m.GetTo(), Payload: b, Snapshot: m.GetType() == pb.MsgSnap})
+}
