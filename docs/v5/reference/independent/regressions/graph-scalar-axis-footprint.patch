+func TestScalarScopeRegressionScopeProjectionExactByteLimits(t *testing.T) {
+	v := newFixtureView(t)
+	v.defs["scope"] = PropertyDefinition{Name: "scope", Owner: Node, Type: ScalarScope, Cardinality: ScalarCardinality}
+	d := v.axis.Descriptor()
+	d.ID[0] = 9
+	d.Reference = strings.Repeat("property-axis-definition-", 200)
+	a, err := temporal.NewAxis(d, temporal.Limits{})
+	if err != nil {
+		t.Fatal(err)
+	}
+	scope, _ := temporal.All(a)
+	r, _ := state.NewRevision(1, 1)
+	owned := testSpan(t, v.axis, 0, 10)
+	delta, err := Plan(t.Context(), v, []Operation{{Kind: CreateNode, Owner: 1, Life: 1, Scope: owned}, {Kind: Set, Owner: 1, Life: 1, Scope: owned, Name: "scope", Value: ScopeValue(scope), ValueID: 1}}, r, Limits{})
+	if err != nil {
+		t.Fatal(err)
+	}
+	v.install(t, delta)
+	for _, target := range []string{"MaxReadBytes", "MaxDeltaBytes"} {
+		t.Run(target, func(t *testing.T) {
+			run := func(cap int) (Projection, error) {
+				l := DefaultLimits()
+				if target == "MaxReadBytes" {
+					l.MaxReadBytes = cap
+				} else {
+					l.MaxDeltaBytes = cap
+				}
+				return Project(t.Context(), v, 1, testPosition(t, v.axis, 5), Effective, l)
+			}
+			lo, hi := 1, 64<<20
+			for lo < hi {
+				mid := lo + (hi-lo)/2
+				_, err := run(mid)
+				if err == nil {
+					hi = mid
+				} else if errors.Is(err, ErrResourceLimit) || errors.Is(err, temporal.ErrResourceLimit) || errors.Is(err, state.ErrResourceLimit) {
+					lo = mid + 1
+				} else {
+					t.Fatal(err)
+				}
+			}
+			p, err := run(lo)
+			if err != nil || len(p.Properties) != 1 {
+				t.Fatal("exact fit", err)
+			}
+			_, err = run(lo - 1)
+			if !errors.Is(err, ErrResourceLimit) && !errors.Is(err, temporal.ErrResourceLimit) && !errors.Is(err, state.ErrResourceLimit) {
+				t.Fatal("one-byte lower", err)
+			}
+			minimumFull := 27 + len(d.Reference) + len(d.CanonicalUnit)
+			if lo < minimumFull {
+				t.Errorf("%s minimum%d is smaller than carried axis metadata%d", target, lo, minimumFull)
+			}
+			t.Log(target, "minimum fitting", lo, "axis metadata", minimumFull)
+		})
+	}
+}
