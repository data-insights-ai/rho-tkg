+func TestScalarScopeRegressionAxisDefinitionRefusal(t *testing.T) {
+	for _, target := range []string{"MaxReadBytes", "MaxDeltaBytes"} {
+		t.Run(target, func(t *testing.T) {
+			v := newFixtureView(t)
+			v.defs["span"] = PropertyDefinition{Name: "span", Owner: Node, Type: ScalarScope, Cardinality: ScalarCardinality}
+			before := v.clone()
+			d := v.axis.Descriptor()
+			d.ID[0] = 2
+			d.Reference = strings.Repeat("R", 32000)
+			a, err := temporal.NewAxis(d, temporal.Limits{})
+			if err != nil {
+				t.Fatal(err)
+			}
+			scope, _ := temporal.All(a)
+			l := DefaultLimits()
+			if target == "MaxReadBytes" {
+				l.MaxReadBytes = 8192
+			} else {
+				l.MaxDeltaBytes = 8192
+			}
+			r, _ := state.NewRevision(1, 1)
+			delta, err := Plan(t.Context(), v, []Operation{{Kind: CreateNode, Owner: 1, Life: 1, Scope: testSpan(t, v.axis, 0, 10)}, {Kind: Set, Owner: 1, Life: 1, Scope: testSpan(t, v.axis, 0, 10), Name: "span", Value: ScopeValue(scope), ValueID: 1}}, r, l)
+			if !errors.Is(err, ErrResourceLimit) && !errors.Is(err, temporal.ErrResourceLimit) && !errors.Is(err, state.ErrResourceLimit) {
+				t.Fatalf("%s=8192 accepted ScopeValue owning32000-byte axis Reference: err=%v values=%d patches=%d deps=%d", target, err, len(delta.Values), len(delta.Patches), len(delta.Dependencies))
+			}
+			if len(delta.Entities)+len(delta.Lives)+len(delta.Values)+len(delta.Patches)+len(delta.Dependencies) != 0 {
+				t.Fatal("resource refusal returned partial transaction metadata")
+			}
+			if len(v.entities)+len(v.lives)+len(v.values)+len(v.components) != 0 ||
+				v.Identity() != before.Identity() || v.Graph() != before.Graph() ||
+				v.axis.DefinitionHash() != before.axis.DefinitionHash() ||
+				len(v.defs) != len(before.defs) || v.defs["span"] != before.defs["span"] {
+				t.Fatal("resource refusal mutated the empty source view")
+			}
+		})
+	}
