+func TestScalarScopeRegressionScopeSharingNodeRelationshipFullAxisFootprint(t *testing.T) {
+	v := newFixtureView(t)
+	v.defs["nodeScope"] = PropertyDefinition{Name: "nodeScope", Owner: Node, Type: ScalarScope, Cardinality: ScalarCardinality}
+	v.defs["relScope"] = PropertyDefinition{Name: "relScope", Owner: Relationship, Type: ScalarScope, Cardinality: ScalarCardinality}
+	d := v.axis.Descriptor()
+	d.ID[0] = 8
+	d.Reference = strings.Repeat("axis-ref-", 400)
+	a, err := temporal.NewAxis(d, temporal.Limits{})
+	if err != nil {
+		t.Fatal(err)
+	}
+	scope, _ := temporal.All(a)
+	wire, err := temporal.AppendScope(nil, scope, temporal.Limits{})
+	if err != nil {
+		t.Fatal(err)
+	}
+	fullBytes := len(wire) + 1 + 27 + len(d.Reference) + len(d.CanonicalUnit)
+	r, _ := state.NewRevision(1, 1)
+	owned := testSpan(t, v.axis, 0, 10)
+	ops := []Operation{{Kind: CreateNode, Owner: 1, Life: 1, Scope: owned}, {Kind: CreateNode, Owner: 2, Life: 1, Scope: owned}, {Kind: CreateRelationship, Owner: 3, Life: 1, Scope: owned, Record: EntityRecord{Type: "LINK", Source: 1, Target: 2, Mode: LifeBound}, Binding: LifeRecord{SourceLife: 1, TargetLife: 1}},
+		{Kind: Set, Owner: 1, Life: 1, Scope: owned, Name: "nodeScope", Value: ScopeValue(scope), ValueID: 77}, {Kind: Set, Owner: 3, Life: 1, Scope: owned, Name: "relScope", Value: ScopeValue(scope), ValueID: 78}}
+	delta, err := Plan(t.Context(), v, ops, r, Limits{})
+	if err != nil {
+		t.Fatal(err)
+	}
+	if len(delta.Values) != 1 || delta.Values[0].ID != 77 {
+		t.Fatal("canonical typed value sharing changed", delta.Values)
+	}
+	for _, patch := range delta.Patches {
+		if patch.Key.Kind != ScalarProperty {
+			continue
+		}
+		for _, change := range patch.Changes {
+			if change.After().Value().ID() != 77 || change.After().Value().PayloadBytes() != uint64(fullBytes) {
+				t.Errorf("owner%d reference ledger lacks full axis: ID=%d bytes=%d want=%d", patch.Key.Owner, change.After().Value().ID(), change.After().Value().PayloadBytes(), fullBytes)
+			}
+		}
+	}
+	v.install(t, delta)
+	replayed, err := Plan(t.Context(), v, []Operation{{Kind: Set, Owner: 1, Life: 1, Scope: owned, Name: "nodeScope", Value: ScopeValue(scope), ValueID: 99}, {Kind: Set, Owner: 3, Life: 1, Scope: owned, Name: "relScope", Value: ScopeValue(scope), ValueID: 100}}, r, Limits{})
+	if err != nil || len(replayed.Patches) != 0 || len(replayed.Values) != 0 {
+		t.Fatal("shared ScopeValue replay must retain full-cell identity and emit no CDC", err)
+	}
+	for _, owner := range []EntityID{1, 3} {
+		p, err := Project(t.Context(), v, owner, testPosition(t, v.axis, 5), Effective, Limits{})
+		if err != nil || len(p.Properties) != 1 {
+			t.Fatal(err)
+		}
+		got, ok := p.Properties[0].Scalar.Scope()
+		if !ok || got.Axis().DefinitionHash() != a.DefinitionHash() {
+			t.Fatal("node/relationship scope preservation diverged")
+		}
+	}
+	key, err := ScopeValue(scope).EqualityKey(Limits{})
+	if err != nil {
+		t.Fatal(err)
+	}
+	wantKey := string(append([]byte{byte(ScalarScope)}, wire...))
+	if key != wantKey {
+		t.Fatal("accounting must not alter canonical equality bytes")
+	}
+	conflict := d
+	conflict.Reference += "different-definition"
+	b, err := temporal.NewAxis(conflict, temporal.Limits{})
+	if err != nil {
+		t.Fatal(err)
+	}
+	other, _ := temporal.All(b)
+	if _, err := scope.SameSupport(other, temporal.Limits{}); !errors.Is(err, temporal.ErrAxisMismatch) {
+		t.Fatal("same-ID definitions silently compared", err)
+	}
+	same, err := ScopeValue(scope).Equal(ScopeValue(other), Limits{})
+	if err != nil || same {
+		t.Fatal("different axis definitions collapsed to one scalar identity", err)
+	}
+}
