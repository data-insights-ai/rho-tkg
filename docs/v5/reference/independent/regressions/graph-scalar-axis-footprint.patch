+// metadataBytes accounts a materialized scalar's complete immutable axis
+// definition separately from its unchanged canonical equality-key bytes.
+// Definitions are charged per occurrence; this ledger does not infer sharing
+// from an ID or promise a measured Go heap cost.
+func (v Scalar) metadataBytes(l Limits) (int, error) {
+	b, err := v.bytes(l)
+	if err != nil {
+		return 0, err
+	}
+	n := len(b)
+	if v.kind == ScalarScope {
+		definition := axisBytes(v.scope.Axis())
+		if definition > l.MaxReadBytes-n {
+			return 0, ErrResourceLimit
+		}
+		n += definition
+	}
+	return n, nil
+}
