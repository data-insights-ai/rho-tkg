+func TestScalarScopeRegressionNodeRelationshipNullRetractionExactReplay(t *testing.T) {
+	v := newFixtureView(t)
+	for _, d := range []PropertyDefinition{{Name: "nodeNull", Owner: Node, Type: ScalarString, Cardinality: ScalarCardinality}, {Name: "relNull", Owner: Relationship, Type: ScalarString, Cardinality: ScalarCardinality}} {
+		v.defs[d.Name] = d
+	}
+	owned := testSpan(t, v.axis, 0, 10)
+	r, _ := state.NewRevision(1, 1)
+	delta, err := Plan(t.Context(), v, []Operation{{Kind: CreateNode, Owner: 1, Life: 1, Scope: owned}, {Kind: CreateNode, Owner: 2, Life: 1, Scope: owned}, {Kind: CreateRelationship, Owner: 3, Life: 1, Scope: owned, Record: EntityRecord{Type: "LINK", Source: 1, Target: 2, Mode: LifeBound}, Binding: LifeRecord{SourceLife: 1, TargetLife: 1}},
+		{Kind: Set, Owner: 1, Life: 1, Scope: owned, Name: "nodeNull", Value: Null()}, {Kind: Set, Owner: 3, Life: 1, Scope: owned, Name: "relNull", Value: Null()}}, r, Limits{})
+	if err != nil {
+		t.Fatal(err)
+	}
+	v.install(t, delta)
+	old := v.clone()
+	replay, err := Plan(t.Context(), v, []Operation{{Kind: Set, Owner: 1, Life: 1, Scope: owned, Name: "nodeNull", Value: Null()}, {Kind: Set, Owner: 3, Life: 1, Scope: owned, Name: "relNull", Value: Null()}}, r, Limits{})
+	if err != nil || len(replay.Patches) != 0 {
+		t.Fatal("exact node/relationship replay emitted CDC", err)
+	}
+	r2, _ := state.NewRevision(2, 2)
+	window := testSpan(t, v.axis, 3, 7)
+	removed, err := Plan(t.Context(), v, []Operation{{Kind: Unset, Owner: 1, Life: 1, Scope: window, Name: "nodeNull"}, {Kind: Unset, Owner: 3, Life: 1, Scope: window, Name: "relNull"}}, r2, Limits{})
+	if err != nil {
+		t.Fatal(err)
+	}
+	for _, patch := range removed.Patches {
+		if len(patch.Changes) != 1 {
+			t.Fatal("exact CDC count", len(patch.Changes))
+		}
+		c := patch.Changes[0]
+		if !c.Before().Present() || !c.Before().Value().IsNull() || c.Before().Revision() != r || c.After().Present() || c.After().Revision() != r2 {
+			t.Fatal("null/retraction full-cell CDC identity changed")
+		}
+		same, err := c.Scope().SameSupport(window, temporal.Limits{})
+		if err != nil || !same {
+			t.Fatal(err)
+		}
+	}
+	v.install(t, removed)
+	for _, owner := range []EntityID{1, 3} {
+		prior, err := Project(t.Context(), old, owner, testPosition(t, v.axis, 5), Effective, Limits{})
+		if err != nil || len(prior.Properties) != 1 || prior.Properties[0].Scalar.Kind() != ScalarNull {
+			t.Fatal("old view lost null", err)
+		}
+		current, err := Project(t.Context(), v, owner, testPosition(t, v.axis, 5), Effective, Limits{})
+		if err != nil || len(current.Properties) != 0 {
+			t.Fatal("current view lost retraction", err)
+		}
+		tail, err := Project(t.Context(), v, owner, testPosition(t, v.axis, 7), Effective, Limits{})
+		if err != nil || len(tail.Properties) != 1 {
+			t.Fatal("half-open null tail lost", err)
+		}
+	}
+}
