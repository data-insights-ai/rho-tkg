+package idalloc
+
+import (
+	"bytes"
+	"encoding/binary"
+	"errors"
+	"testing"
+)
+
+// CRC and request digest consistency cannot establish that a receipt could
+// result from the allocator's sequence of positive, contiguous reservations.
+func TestCheckpointReceiptRequiresAllocationFloor(t *testing.T) {
+	state, request := fixture(t)
+	request.Count = 1
+	state, _, _, err := Reserve(&state, request)
+	if err != nil {
+		t.Fatal(err)
+	}
+	valid, err := MarshalCheckpoint(&state)
+	if err != nil {
+		t.Fatal(err)
+	}
+	for _, receipt := range []struct {
+		name                         string
+		sequence, first, high, count uint64
+	}{
+		{"sequence exceeds highwater", 2, 1, 1, 1},
+		{"sequence exceeds first but not highwater", 3, 2, 3, 2},
+	} {
+		t.Run(receipt.name, func(t *testing.T) {
+			invalid := state
+			invalid.sequence, invalid.first, invalid.high, invalid.count = receipt.sequence, receipt.first, receipt.high, receipt.count
+			r := request
+			r.Sequence, r.Count = receipt.sequence, receipt.count
+			invalid.digest = r.Digest()
+			if _, err := MarshalCheckpoint(&invalid); !errors.Is(err, ErrInvalid) {
+				t.Fatalf("MarshalCheckpoint accepted impossible receipt: %v", err)
+			}
+			image := bytes.Clone(valid)
+			binary.BigEndian.PutUint64(image[45:53], receipt.high)
+			binary.BigEndian.PutUint64(image[61:69], receipt.sequence)
+			binary.BigEndian.PutUint64(image[69:77], receipt.count)
+			binary.BigEndian.PutUint64(image[77:85], receipt.first)
+			copy(image[85:117], invalid.digest[:])
+			checksum(image)
+			if _, err := DecodeCheckpoint(image); !errors.Is(err, ErrCorrupt) {
+				t.Fatalf("DecodeCheckpoint accepted CRC/digest-valid impossible receipt: %v", err)
+			}
+		})
+	}
+	// A transferred authority resets sequence but retains every reserved ID;
+	// the floor guard must not reject its nonzero high-water initial receipt.
+	authority, err := NewAuthority([16]byte{3}, 2)
+	if err != nil {
+		t.Fatal(err)
+	}
+	transferred, err := Transfer(&state, request.Authority, authority)
+	if err != nil {
+		t.Fatal(err)
+	}
+	image, err := MarshalCheckpoint(&transferred)
+	if err != nil {
+		t.Fatal(err)
+	}
+	restored, err := DecodeCheckpoint(image)
+	if err != nil || restored.high != 1 || restored.sequence != 0 {
+		t.Fatal(restored, err)
+	}
+}
