@@ -0,0 +1,615 @@
+package txnproto
+
+import (
+	"context"
+	"errors"
+	"fmt"
+	"testing"
+
+	"github.com/cockroachdb/pebble/v2/vfs"
+	"github.com/data-insights-ai/rho-tkg/v5/internal/idalloc"
+	"github.com/data-insights-ai/rho-tkg/v5/internal/raftlog"
+)
+
+// These tests use completed Host.Read barriers and actual replicated application
+// entries, rather than a synthetic durable callback or caller quorum boolean.
+func TestIndependentDelayedCommittedGrantAfterRecipientRotation(t *testing.T) {
+	n := allocationNetwork(t)
+	p, e := n.hosts[1].TransferAllocator(n.read(t, 1, Query{Kind: AllocatorState}))
+	n.submit(t, 1, p, e)
+	original := activateRecipient(t, n, 1, [16]byte{31})
+	other := activateRecipient(t, n, 4, [16]byte{32})
+	otherCursor, otherProof := acquire(t, n, other, 1, 4)
+	var delayed Reply
+	var replacement *RecipientHandle
+	_, e = original.Acquire(t.Context(), 1, 3, func(ctx context.Context, intent Proposal, q Query) (Reply, error) {
+		var err error
+		delayed, err = allocationTransport(t, n, 1)(ctx, intent, q)
+		if err != nil {
+			return Reply{}, err
+		}
+		replacement = activateRecipient(t, n, 1, original.session.ID)
+		return delayed, nil
+	})
+	if !errors.Is(e, ErrStale) {
+		t.Fatal("delayed old-session response opened cursor", e)
+	}
+	high := n.read(t, 1, Query{Kind: AllocatorState}).View().Allocator.HighWater
+	if high != 7 {
+		t.Fatal("unknown reservation not retained", high)
+	}
+	fresh, freshProof := acquire(t, n, replacement, 1, 2)
+	if freshProof.View().Grant.First != 8 {
+		t.Fatal("old range reused", freshProof.View().Grant)
+	}
+	if id, e := fresh.Next(); e != nil || id != 8 {
+		t.Fatal(id, e)
+	}
+	// A service outage cannot revoke a disjoint B block or add per-ID requests.
+	for _, id := range []uint64{1, 2, 3} {
+		n.drop[id] = true
+	}
+	for j := range 4 {
+		id, e := otherCursor.Next()
+		if e != nil || id != uint64(j+1) {
+			t.Fatal("other block invalidated", id, e)
+		}
+		x := tx(fmt.Sprintf("independent-cached-%d", j), 1, participant(1, uint64(j), Effect{Key: fmt.Sprintf("row%d", j), Value: int64(id)}))
+		p, e = LocalIDs(x, otherProof, []uint64{id})
+		n.submit(t, 4, p, e)
+		if n.hosts[4].machine.last != nil {
+			t.Fatal(n.hosts[4].machine.last)
+		}
+		if !n.read(t, 4, Query{Kind: Decided, TxID: x.ID}).View().Decision.Commit {
+			t.Fatal("cached local commit not committed")
+		}
+	}
+	if _, e = otherCursor.Next(); !errors.Is(e, idalloc.ErrExhausted) {
+		t.Fatal(e)
+	}
+	got := n.read(t, 4, Query{Kind: Current}).View().State
+	exact(t, *got, map[string]int64{"row0": 1, "row1": 2, "row2": 3, "row3": 4})
+	t.Log("late committed range [5,7] abandoned; replacement [8,9]; B exact [1,4] committed without A")
+}
+
+func independentReopenAllocation(t *testing.T, n *network, id uint64, checkpoint bool) {
+	t.Helper()
+	if checkpoint {
+		if e := n.hosts[id].SaveCheckpoint(); e != nil {
+			t.Fatal(e)
+		}
+	}
+	oldSession := n.hosts[id].readSession
+	crash := n.files[id].CrashClone(vfs.CrashCloneCfg{})
+	if e := n.hosts[id].Close(); e != nil {
+		t.Fatal(e)
+	}
+	store, e := raftlog.Open(raftlog.Config{Dir: fmt.Sprint(id), FS: crash})
+	if e != nil {
+		t.Fatal(e)
+	}
+	host, e := OpenHost(allocationConfig(uint8((id-1)/3)), store, id)
+	if e != nil {
+		t.Fatal(e)
+	}
+	if host.readSession == oldSession {
+		t.Fatal("reopen reused incarnation")
+	}
+	n.hosts[id] = host
+	n.files[id] = crash
+	n.elect(t, id)
+}
+
+func independentActivateRecoveredHome(t *testing.T, n *network, home uint64, key [16]byte) *RecipientHandle {
+	t.Helper()
+	current := n.read(t, home, Query{Kind: RecipientState, RecipientID: key})
+	p, e := n.hosts[home].BeginRecipient(key, current)
+	n.submit(t, 1, p, e)
+	begin := n.read(t, 1, Query{Kind: RecipientState, RecipientID: key})
+	for _, dest := range []uint64{1, 4} {
+		p, e = FenceRecipient(begin)
+		n.submit(t, dest, p, e)
+	}
+	b := n.read(t, 4, Query{Kind: RecipientState, RecipientID: key})
+	p, e = RecordRecipientFence(b)
+	n.submit(t, 1, p, e)
+	a := n.read(t, 1, Query{Kind: RecipientState, RecipientID: key})
+	ack := n.read(t, 1, Query{Kind: RecipientAck, RecipientID: key})
+	p, e = ActivateRecipient(a, ack)
+	n.submit(t, 1, p, e)
+	active := n.read(t, 1, Query{Kind: RecipientState, RecipientID: key})
+	p, e = PublishRecipient(active)
+	n.submit(t, 4, p, e)
+	handle, e := n.hosts[home].OpenRecipient(n.read(t, home, Query{Kind: RecipientState, RecipientID: key}))
+	if e != nil {
+		t.Fatal(e)
+	}
+	return handle
+}
+
+func TestIndependentWriterRestartLogReplayAndOwnHomeProof(t *testing.T) {
+	for _, checkpoint := range []bool{false, true} {
+		t.Run(fmt.Sprintf("checkpoint=%v", checkpoint), func(t *testing.T) {
+			n := allocationNetwork(t)
+			p, e := n.hosts[1].TransferAllocator(n.read(t, 1, Query{Kind: AllocatorState}))
+			n.submit(t, 1, p, e)
+			writerA := activateRecipient(t, n, 1, [16]byte{41})
+			writerB := activateRecipient(t, n, 4, [16]byte{42})
+			cursorA, proofA := acquire(t, n, writerA, 1, 4)
+			cursorB, proofB := acquire(t, n, writerB, 1, 4)
+			firstB, e := cursorB.Next()
+			if e != nil || firstB != 5 {
+				t.Fatal(firstB, e)
+			}
+			oldActive := n.read(t, 4, Query{Kind: RecipientState, RecipientID: writerB.session.ID})
+			independentReopenAllocation(t, n, 4, checkpoint)
+			if _, e = n.hosts[4].OpenRecipient(oldActive); !errors.Is(e, ErrStale) {
+				t.Fatal("old process proof reopened recipient", e)
+			}
+			if _, e = n.hosts[4].OpenRecipient(n.read(t, 4, Query{Kind: RecipientState, RecipientID: writerB.session.ID})); !errors.Is(e, ErrStale) {
+				t.Fatal("inspection revived old incarnation", e)
+			}
+			newB := independentActivateRecoveredHome(t, n, 4, writerB.session.ID)
+			newCursor, newProof := acquire(t, n, newB, 1, 2)
+			if newProof.View().Grant.First != 9 || newB.session.Epoch != 2 || newB.session.Incarnation == writerB.session.Incarnation {
+				t.Fatal("restart reused reserved tail/session", newProof.View().Grant, newB.session)
+			}
+			stale := tx("independent-old-B", 1, participant(1, 0, Effect{Key: "phantom", Value: 99}))
+			p, e = LocalIDs(stale, proofB, []uint64{firstB})
+			n.submit(t, 4, p, e)
+			if !errors.Is(n.hosts[4].machine.last, ErrStale) {
+				t.Fatal("old cached grant committed", n.hosts[4].machine.last)
+			}
+			for j := range 4 {
+				id, e := cursorA.Next()
+				if e != nil || id != uint64(j+1) {
+					t.Fatal("A tail changed across B restart", id, e)
+				}
+				x := tx(fmt.Sprintf("independent-A-%d", j), 0, participant(0, uint64(j), Effect{Key: fmt.Sprintf("a%d", j), Value: int64(id)}))
+				p, e = LocalIDs(x, proofA, []uint64{id})
+				n.submit(t, 1, p, e)
+				if n.hosts[1].machine.last != nil {
+					t.Fatal("A grant invalidated", n.hosts[1].machine.last)
+				}
+			}
+			id, e := newCursor.Next()
+			if e != nil || id != 9 {
+				t.Fatal(id, e)
+			}
+			x := tx("independent-new-B", 1, participant(1, 0, Effect{Key: "fresh", Value: int64(id)}))
+			p, e = LocalIDs(x, newProof, []uint64{id})
+			n.submit(t, 4, p, e)
+			if n.hosts[4].machine.last != nil {
+				t.Fatal(n.hosts[4].machine.last)
+			}
+			exact(t, *n.read(t, 4, Query{Kind: Current}).View().State, map[string]int64{"fresh": 9})
+			t.Log("A [1,4] remains usable; B partial [5,8] retired; new B [9,10]; phantom absent")
+		})
+	}
+}
+
+func TestIndependentSixProcessUncheckpointedWriterRestart(t *testing.T) {
+	n := newProcessClusterMode(t, true)
+	service := n.read(1, Query{Kind: AllocatorState})
+	n.submit(1, n.build(1, processRequest{Op: "service", Handle: service.Handle}))
+	writerA := n.recipient(1, [16]byte{51})
+	writerB := n.recipient(4, [16]byte{52})
+	cursorA, proofA := n.acquireIDs(1, writerA, 1, 4, false)
+	cursorB, proofB := n.acquireIDs(4, writerB, 1, 4, false)
+	oldID := n.run(4, processRequest{Op: "mint", Handle: cursorB}).ID
+	if oldID != 5 {
+		t.Fatal(oldID)
+	}
+	n.stage = "independent-uncheckpointed-writer-SIGKILL"
+	n.crashReopen(4)
+	if got := n.rpc(4, processRequest{Op: "mint", Handle: cursorB}); !errors.Is(processErr(got.Err), ErrUnavailable) {
+		t.Fatal("cursor restored", got.Err)
+	}
+	writerB = n.recipient(4, [16]byte{52})
+	_, fresh := n.acquireIDs(4, writerB, 1, 2, false)
+	if fresh.View.Grant.First != 9 || fresh.View.Grant.Request.Session.Epoch != 2 {
+		t.Fatal("uncheckpointed replay reused tail", fresh.View.Grant)
+	}
+	oldProof := n.read(4, proofB.Query)
+	oldTx := tx("independent-process-old", 1, participant(1, 0, Effect{Key: "phantom", Value: 99}))
+	n.submit(4, n.build(4, processRequest{Op: "local-ids", Handle: oldProof.Handle, Tx: oldTx, IDs: []uint64{oldID}}))
+	if got := n.rpc(4, processRequest{Op: "last"}); !errors.Is(processErr(got.Err), ErrStale) {
+		t.Fatal("old process claim committed", got.Err)
+	}
+	id := n.run(1, processRequest{Op: "mint", Handle: cursorA}).ID
+	if id != 1 {
+		t.Fatal("other process cached range changed", id)
+	}
+	x := tx("independent-process-cached", 0, participant(0, 0, Effect{Key: "cached", Value: int64(id)}))
+	n.submit(1, n.build(1, processRequest{Op: "local-ids", Handle: proofA.Handle, Tx: x, IDs: []uint64{id}}))
+	if !n.read(1, Query{Kind: Decided, TxID: x.ID}).View.Decision.Commit {
+		t.Fatal("surviving process could not commit")
+	}
+	exact(t, *n.read(4, Query{Kind: Current}).View.State, map[string]int64{})
+	exact(t, *n.read(1, Query{Kind: Current}).View.State, map[string]int64{"cached": 1})
+	t.Logf("six actual processes: uncheckpointed B killed/replayed; old [5,8] fenced; new [9,10]; A [1,4] commits; events=%d", n.steps)
+}
+
+func TestIndependentRetainedGrantReplayDoesNotAllocateAfterLaterRefills(t *testing.T) {
+	n := allocationNetwork(t)
+	p, e := n.hosts[1].TransferAllocator(n.read(t, 1, Query{Kind: AllocatorState}))
+	n.submit(t, 1, p, e)
+	h := activateRecipient(t, n, 4, [16]byte{61})
+	_, old := acquire(t, n, h, 1, 2)
+	for sequence := uint64(2); sequence <= 4; sequence++ {
+		acquire(t, n, h, sequence, 2)
+	}
+	high := n.read(t, 1, Query{Kind: AllocatorState}).View().Allocator.HighWater
+	r := old.View().Grant.Request
+	intent, e := allocationProposal(allocationCommand{Op: "reserve", Request: &r})
+	if e != nil {
+		t.Fatal(e)
+	}
+	p, e = n.hosts[1].AuthorizeReserve(intent, n.read(t, 1, Query{Kind: AllocatorState}))
+	n.submit(t, 1, p, e)
+	same := n.read(t, 1, grantQuery(r))
+	if *same.View().Grant != *old.View().Grant || n.read(t, 1, Query{Kind: AllocatorState}).View().Allocator.HighWater != high {
+		t.Fatal("retained replay changed block/high-water")
+	}
+	if _, e = h.Acquire(t.Context(), 1, 2, func(context.Context, Proposal, Query) (Reply, error) {
+		t.Fatal("old request redelivered")
+		return Reply{}, nil
+	}); !errors.Is(e, idalloc.ErrAlreadyReserved) {
+		t.Fatal(e)
+	}
+	r.Count++
+	intent, e = allocationProposal(allocationCommand{Op: "reserve", Request: &r})
+	if e != nil {
+		t.Fatal(e)
+	}
+	p, e = n.hosts[1].AuthorizeReserve(intent, n.read(t, 1, Query{Kind: AllocatorState}))
+	n.submit(t, 1, p, e)
+	if !errors.Is(n.hosts[1].machine.last, ErrMismatch) {
+		t.Fatal("old retained identity changed payload", n.hosts[1].machine.last)
+	}
+	if n.read(t, 1, Query{Kind: AllocatorState}).View().Allocator.HighWater != 8 {
+		t.Fatal("replay advanced high-water")
+	}
+	t.Log("service reducer keeps latest receipt; protocol retained grant sequence 1 unchanged after refills 2..4")
+}
