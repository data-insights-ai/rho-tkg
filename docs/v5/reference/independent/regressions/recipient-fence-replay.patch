+// The proof/proposals below come from completed quorum reads. Replays are
+// delivered through Host.Submit and committed by the real replicated reducer.
+func TestIndependentFenceReplayBothHomesThroughRestart(t *testing.T) {
+	for _, home := range []uint64{1, 4} {
+		t.Run(fmt.Sprintf("home=%d", home), func(t *testing.T) {
+			n := allocationNetwork(t)
+			p, e := n.hosts[1].TransferAllocator(n.read(t, 1, Query{Kind: AllocatorState}))
+			n.submit(t, 1, p, e)
+			key := [16]byte{121}
+			beginProposal, e := n.hosts[home].BeginRecipient(key, Proof{})
+			n.submit(t, 1, beginProposal, e)
+			begin := n.read(t, 1, Query{Kind: RecipientState, RecipientID: key})
+			fencePending, e := FenceRecipient(begin)
+			if e != nil {
+				t.Fatal(e)
+			}
+			for _, dest := range []uint64{1, 4} {
+				n.submit(t, dest, fencePending, nil)
+				before := n.read(t, dest, Query{Kind: RecipientState, RecipientID: key}).View().Recipient
+				n.submit(t, dest, fencePending, nil)
+				after := n.read(t, dest, Query{Kind: RecipientState, RecipientID: key}).View().Recipient
+				if digest(before) != digest(after) || after.Phase != "fenced" {
+					t.Fatal("pre-activation duplicate changed fence", dest, before, after)
+				}
+			}
+			// The old begin can arrive after its fence, without moving it back to pending.
+			n.submit(t, 1, beginProposal, nil)
+			a := n.read(t, 1, Query{Kind: RecipientState, RecipientID: key})
+			b := n.read(t, 4, Query{Kind: RecipientState, RecipientID: key})
+			if a.View().Recipient.Phase != "fenced" {
+				t.Fatal("begin replay regressed fence")
+			}
+			fenceFenced, e := FenceRecipient(a)
+			if e != nil {
+				t.Fatal(e)
+			}
+			for _, dest := range []uint64{1, 4} {
+				n.submit(t, dest, fenceFenced, nil)
+			}
+			p, e = ActivateRecipient(a, b)
+			n.submit(t, 1, p, e)
+			active := n.read(t, 1, Query{Kind: RecipientState, RecipientID: key})
+			p, e = PublishRecipient(active)
+			n.submit(t, 4, p, e)
+			handle, e := n.hosts[home].OpenRecipient(n.read(t, home, Query{Kind: RecipientState, RecipientID: key}))
+			if e != nil {
+				t.Fatal(e)
+			}
+			cursor, grant := acquire(t, n, handle, 1, 4)
+			otherHome := uint64(5) - home
+			other := activateRecipient(t, n, otherHome, [16]byte{122})
+			otherCursor, otherGrant := acquire(t, n, other, 1, 4)
+			before := [2]*RecipientRecord{}
+			for index, dest := range []uint64{1, 4} {
+				before[index] = n.read(t, dest, Query{Kind: RecipientState, RecipientID: key}).View().Recipient
+			}
+			n.submit(t, 1, beginProposal, nil)
+			// Both source pending and source fenced observations are delayed duplicates.
+			for _, fence := range []Proposal{fenceFenced, fencePending, fenceFenced, fencePending} {
+				for _, dest := range []uint64{4, 1} {
+					n.submit(t, dest, fence, nil)
+				}
+			}
+			for index, dest := range []uint64{1, 4} {
+				after := n.read(t, dest, Query{Kind: RecipientState, RecipientID: key}).View().Recipient
+				if digest(before[index]) != digest(after) || after.Phase != "active" {
+					t.Fatal("post-activation replay changed phase/sequence/budget/session", dest, before[index], after)
+				}
+			}
+			if n.read(t, 1, Query{Kind: AllocatorState}).View().Allocator.HighWater != 8 {
+				t.Fatal("fence replay changed global high-water")
+			}
+			seen := map[uint64]bool{}
+			mint := func(c *idalloc.Cursor, want uint64) uint64 {
+				t.Helper()
+				id, e := c.Next()
+				if e != nil || id != want || seen[id] {
+					t.Fatal("duplicate/reused mint", id, want, e)
+				}
+				seen[id] = true
+				return id
+			}
+			commit := func(dest uint64, g Proof, id uint64, name string, generation uint64) {
+				t.Helper()
+				group := uint8((dest - 1) / 3)
+				x := tx(name, group, participant(group, generation, Effect{Key: name, Value: int64(id)}))
+				p, e := LocalIDs(x, g, []uint64{id})
+				n.submit(t, dest, p, e)
+				if n.hosts[dest].machine.last != nil || !n.read(t, dest, Query{Kind: Decided, TxID: x.ID}).View().Decision.Commit {
+					t.Fatal("cached claim rejected", dest, n.hosts[dest].machine.last)
+				}
+			}
+			first := mint(cursor, 1)
+			commit(home, grant, first, "before-restart", 0)
+			second := mint(otherCursor, 5)
+			commit(otherHome, otherGrant, second, "other-before", 0)
+			// A retained request's count cannot change after delayed fence replays.
+			bad := grant.View().Grant.Request
+			bad.Count++
+			intent, e := allocationProposal(allocationCommand{Op: "reserve", Request: &bad})
+			if e != nil {
+				t.Fatal(e)
+			}
+			p, e = n.hosts[1].AuthorizeReserve(intent, n.read(t, 1, Query{Kind: AllocatorState}))
+			n.submit(t, 1, p, e)
+			if !errors.Is(n.hosts[1].machine.last, ErrMismatch) || n.read(t, 1, Query{Kind: AllocatorState}).View().Allocator.HighWater != 8 {
+				t.Fatal("payload mismatch changed retained range")
+			}
+			independentReopenAllocation(t, n, home, false)
+			replacement := independentActivateRecoveredHome(t, n, home, key)
+			if home == 1 {
+				p, e = n.hosts[1].TransferAllocator(n.read(t, 1, Query{Kind: AllocatorState}))
+				n.submit(t, 1, p, e)
+			}
+			fresh, freshGrant := acquire(t, n, replacement, 1, 2)
+			if freshGrant.View().Grant.First != 9 || replacement.session.Epoch != 2 {
+				t.Fatal("restart reused old block", freshGrant.View().Grant, replacement.session)
+			}
+			current := [2]*RecipientRecord{}
+			for index, dest := range []uint64{1, 4} {
+				current[index] = n.read(t, dest, Query{Kind: RecipientState, RecipientID: key}).View().Recipient
+			}
+			n.submit(t, 1, beginProposal, nil)
+			if !errors.Is(n.hosts[1].machine.last, ErrStale) {
+				t.Fatal("old-session begin accepted after new activation", n.hosts[1].machine.last)
+			}
+			for _, fence := range []Proposal{fencePending, fenceFenced} {
+				for _, dest := range []uint64{1, 4} {
+					n.submit(t, dest, fence, nil)
+					if !errors.Is(n.hosts[dest].machine.last, ErrStale) {
+						t.Fatal("old-session fence accepted", dest, n.hosts[dest].machine.last)
+					}
+				}
+			}
+			for index, dest := range []uint64{1, 4} {
+				if digest(current[index]) != digest(n.read(t, dest, Query{Kind: RecipientState, RecipientID: key}).View().Recipient) {
+					t.Fatal("old-session delivery changed current session", dest)
+				}
+			}
+			stale := tx("phantom", uint8((home-1)/3), participant(uint8((home-1)/3), 1, Effect{Key: "phantom", Value: 99}))
+			p, e = LocalIDs(stale, grant, []uint64{first})
+			n.submit(t, home, p, e)
+			if !errors.Is(n.hosts[home].machine.last, ErrStale) {
+				t.Fatal("old cached grant survived recovery", n.hosts[home].machine.last)
+			}
+			id := mint(fresh, 9)
+			commit(home, freshGrant, id, "after-restart", 1)
+			for j := range 3 {
+				id := mint(otherCursor, uint64(j+6))
+				commit(otherHome, otherGrant, id, fmt.Sprintf("other-tail%d", j), uint64(j+1))
+			}
+			if len(seen) != 6 {
+				t.Fatal("inexact unique set", seen)
+			}
+			exact(t, *n.read(t, home, Query{Kind: Current}).View().State, map[string]int64{"before-restart": 1, "after-restart": 9})
+			exact(t, *n.read(t, otherHome, Query{Kind: Current}).View().State, map[string]int64{"other-before": 5, "other-tail0": 6, "other-tail1": 7, "other-tail2": 8})
+			t.Log("both groups retain active phase and sequence under duplicate/reordered fences; newer session rejects old begin/fence; cached other writer survives uncheckpointed restart")
+		})
+	}
+}
+
+func TestIndependentAllocationRejectionsPreserveCommittedState(t *testing.T) {
+	n := allocationNetwork(t)
+	p, e := n.hosts[1].TransferAllocator(n.read(t, 1, Query{Kind: AllocatorState}))
+	n.submit(t, 1, p, e)
+	h := activateRecipient(t, n, 4, [16]byte{131})
+	service := n.read(t, 1, Query{Kind: AllocatorState})
+	activeA := n.read(t, 1, Query{Kind: RecipientState, RecipientID: h.session.ID})
+	activeB := n.read(t, 4, Query{Kind: RecipientState, RecipientID: h.session.ID})
+	beforeA, beforeB := activeA.View().Recipient, activeB.View().Recipient
+	// Valid source-produced proposals delivered to a group that cannot own that
+	// transition must fail, rather than silently installing local copies.
+	cases := []struct {
+		name  string
+		dest  uint64
+		build func() (Proposal, error)
+	}{
+		{"service-at-B", 4, func() (Proposal, error) { return n.hosts[1].TransferAllocator(service) }},
+		{"begin-at-B", 4, func() (Proposal, error) { return n.hosts[4].BeginRecipient(h.session.ID, activeB) }},
+		{"activate-at-B", 4, func() (Proposal, error) { return ActivateRecipient(activeA, activeB) }},
+		{"publish-at-A", 1, func() (Proposal, error) { return PublishRecipient(activeA) }},
+		{"ack-at-B", 4, func() (Proposal, error) { return RecordRecipientFence(activeB) }},
+		{"fence-active-observation", 1, func() (Proposal, error) { return FenceRecipient(activeA) }},
+	}
+	for _, test := range cases {
+		p, e := test.build()
+		n.submit(t, test.dest, p, e)
+		if !errors.Is(n.hosts[test.dest].machine.last, ErrStale) {
+			t.Fatal(test.name, n.hosts[test.dest].machine.last)
+		}
+	}
+	request := idalloc.GrantRequest{Graph: n.hosts[1].machine.config.Namespace, Session: h.session, Sequence: 1, Count: 1}
+	intent, e := allocationProposal(allocationCommand{Op: "reserve", Request: &request})
+	if e != nil {
+		t.Fatal(e)
+	}
+	if _, e = n.hosts[1].AuthorizeReserve(intent, activeA); !errors.Is(e, ErrStale) {
+		t.Fatal("recipient proof certified service", e)
+	}
+	if _, e = n.hosts[4].AuthorizeReserve(intent, service); !errors.Is(e, ErrStale) {
+		t.Fatal("B authorized reservation service", e)
+	}
+	p, e = n.hosts[1].AuthorizeReserve(intent, service)
+	n.submit(t, 4, p, e)
+	if !errors.Is(n.hosts[4].machine.last, ErrStale) {
+		t.Fatal("B reserved a global range", n.hosts[4].machine.last)
+	}
+	for _, query := range []Query{
+		{Kind: AllocatorState, Count: 1},
+		{Kind: RecipientState},
+		{Kind: RecipientState, RecipientID: h.session.ID, Sequence: 1},
+		{Kind: GrantState, RecipientID: h.session.ID, Incarnation: h.session.Incarnation, RecipientEpoch: 1, Sequence: 1},
+		{Kind: AllocatorState, TxID: "unexpected"},
+	} {
+		if _, e = n.hosts[1].Read(query); !errors.Is(e, ErrInvalid) {
+			t.Fatal("invalid allocation query accepted", query, e)
+		}
+	}
+	answerError := func(dest uint64, q Query, want error) {
+		t.Helper()
+		n.replies[dest] = nil
+		out, e := n.hosts[dest].Read(q)
+		n.run(t, dest, out, e)
+		for _, reply := range n.replies[dest] {
+			if reply.ReadID == out.ReadID {
+				if !errors.Is(reply.Err, want) {
+					t.Fatal("read error", q, reply.Err, want)
+				}
+				return
+			}
+		}
+		t.Fatal("no completed read for rejected question", q)
+	}
+	answerError(4, Query{Kind: AllocatorState}, ErrUnavailable)
+	answerError(4, Query{Kind: RecipientAck, RecipientID: h.session.ID}, ErrUnavailable)
+	answerError(1, Query{Kind: RecipientState, RecipientID: [16]byte{255}}, ErrUnavailable)
+	answerError(1, grantQuery(request), ErrUnavailable)
+	if digest(beforeA) != digest(n.read(t, 1, Query{Kind: RecipientState, RecipientID: h.session.ID}).View().Recipient) || digest(beforeB) != digest(n.read(t, 4, Query{Kind: RecipientState, RecipientID: h.session.ID}).View().Recipient) {
+		t.Fatal("rejected commands changed committed sessions")
+	}
+	if n.read(t, 1, Query{Kind: AllocatorState}).View().Allocator.HighWater != 0 {
+		t.Fatal("rejected commands advanced allocation")
+	}
+	_, grant := acquire(t, n, h, 1, 2)
+	mismatched := grant.View().Grant.Request
+	mismatched.Count++
+	answerError(1, grantQuery(mismatched), ErrMismatch)
+	invalidTx := tx("invalid", 1, participant(1, 0))
+	invalidTx.Request = ""
+	if _, e = LocalIDs(invalidTx, grant, []uint64{1}); !errors.Is(e, ErrInvalid) {
+		t.Fatal("malformed transaction reached proposal", e)
+	}
+	claimed := tx("claimed", 1, participant(1, 0))
+	claimed.Claim = &IDClaim{}
+	if _, e = RegisterIDs(claimed, grant, []uint64{1}); !errors.Is(e, ErrInvalid) {
+		t.Fatal("supplied claim rebound", e)
+	}
+	if _, e = LocalIDs(tx("cross-local", 0, participant(0, 0), participant(1, 0)), grant, []uint64{1}); !errors.Is(e, ErrInvalid) {
+		t.Fatal("multi-group local accepted", e)
+	}
+	for index, ids := range [][]uint64{nil, {0}, {3}, {1, 1}, {2, 1}} {
+		x := tx(fmt.Sprintf("invalid-IDs-%d", index), 1, participant(1, 0, Effect{Key: "phantom", Value: 99}))
+		p, e := LocalIDs(x, grant, ids)
+		n.submit(t, 4, p, e)
+		if !errors.Is(n.hosts[4].machine.last, ErrInvalid) {
+			t.Fatal("invalid range/order claim accepted", ids, n.hosts[4].machine.last)
+		}
+	}
+	exact(t, *n.read(t, 1, Query{Kind: Current}).View().State, map[string]int64{})
+	exact(t, *n.read(t, 4, Query{Kind: Current}).View().State, map[string]int64{})
+}
