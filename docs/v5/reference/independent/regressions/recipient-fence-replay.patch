diff --git a/v5/internal/idalloc/independent_recipient_test.go b/v5/internal/idalloc/independent_recipient_test.go
new file mode 100644
index 0000000..0859a99
--- /dev/null
+++ b/v5/internal/idalloc/independent_recipient_test.go
@@ -0,0 +1,254 @@
+package idalloc
+
+import (
+	"errors"
+	"math"
+	"math/rand/v2"
+	"sync"
+	"testing"
+)
+
+// This is an independent arithmetic/lifecycle model. The callback models the
+// trusted durable boundary; it does not claim Raft, disk or process evidence.
+func TestIndependentRecipientModelTwoWritersFaultsAndRestart(t *testing.T) {
+	graph := GraphID{71}
+	authority, err := NewAuthority([16]byte{72}, 1)
+	if err != nil {
+		t.Fatal(err)
+	}
+	state, err := NewState(graph, authority, 8)
+	if err != nil {
+		t.Fatal(err)
+	}
+	type writer struct {
+		session   RecipientSession
+		recipient *Recipient
+		seq       uint64
+		cursors   []*Cursor
+	}
+	writers := [2]writer{}
+	for index := range writers {
+		w := &writers[index]
+		w.session = RecipientSession{ID: [16]byte{byte(index + 1)}, Incarnation: [16]byte{byte(index + 10)}, Epoch: 1}
+		w.recipient, err = NewRecipient(graph, w.session)
+		if err != nil {
+			t.Fatal(err)
+		}
+	}
+	rng := rand.New(rand.NewPCG(456, 789))
+	var modelHigh, globalSeq uint64
+	seen := map[uint64]bool{}
+	var abandoned uint64
+	for step := range 400 {
+		which := rng.IntN(2)
+		w := &writers[which]
+		if step%29 == 0 && step != 0 {
+			// Restart changes only this session; all reserved tails are discarded.
+			for _, c := range w.cursors {
+				b, e := c.Block()
+				if e != nil {
+					t.Fatal(e)
+				}
+				abandoned += b.Last - b.First + 1
+			}
+			w.cursors = nil
+			w.session.Epoch++
+			w.session.Incarnation[1]++
+			w.recipient, err = NewRecipient(graph, w.session)
+			if err != nil {
+				t.Fatal(err)
+			}
+			w.seq = 0
+			// Service authority rotation is independent of the other cached writer.
+			nextAuthority, e := NewAuthority([16]byte{byte(step)}, authority.Epoch()+1)
+			if e != nil {
+				t.Fatal(e)
+			}
+			state, e = Transfer(&state, authority, nextAuthority)
+			if e != nil {
+				t.Fatal(e)
+			}
+			authority = nextAuthority
+			globalSeq = 0
+		}
+		if len(w.cursors) > 0 && rng.IntN(3) == 0 {
+			c := w.cursors[rng.IntN(len(w.cursors))]
+			id, e := c.Next()
+			if errors.Is(e, ErrExhausted) {
+				continue
+			}
+			if e != nil || id == 0 || id > modelHigh || seen[id] {
+				t.Fatalf("step %d duplicate/outside reservation id=%d high=%d err=%v", step, id, modelHigh, e)
+			}
+			seen[id] = true
+			continue
+		}
+		w.seq++
+		count := uint64(rng.IntN(8) + 1)
+		request := GrantRequest{Graph: graph, Session: w.session, Sequence: w.seq, Count: count}
+		before := modelHigh
+		fault := rng.IntN(6)
+		committed := fault != 0
+		calls := 0
+		cursor, e := w.recipient.Acquire(t.Context(), request, func(r GrantRequest) (Grant, error) {
+			calls++
+			if !committed {
+				return Grant{}, ErrUnknown
+			}
+			globalSeq++
+			next, b, replay, reserveErr := Reserve(&state, Request{Graph: graph, Authority: authority, Sequence: globalSeq, Count: count})
+			if reserveErr != nil || replay {
+				t.Fatalf("reserve %v replay=%v", reserveErr, replay)
+			}
+			state = next
+			modelHigh += count
+			if b.First != before+1 || b.Last != modelHigh {
+				t.Fatalf("range %+v expected [%d,%d]", b, before+1, modelHigh)
+			}
+			if fault == 1 {
+				abandoned += count
+				return Grant{}, ErrUnknown
+			}
+			return Grant{Request: r, Reservation: b}, nil
+		})
+		if fault < 2 {
+			if cursor != nil || !errors.Is(e, ErrUnknown) {
+				t.Fatal(cursor, e)
+			}
+		} else {
+			if e != nil {
+				t.Fatal(e)
+			}
+			w.cursors = append(w.cursors, cursor)
+		}
+		if _, e = w.recipient.Acquire(t.Context(), request, func(GrantRequest) (Grant, error) { calls++; return Grant{}, nil }); !errors.Is(e, ErrAlreadyReserved) {
+			t.Fatal("replay", e)
+		}
+		if calls != 1 {
+			t.Fatal("replay entered callback")
+		}
+		image, e := MarshalCheckpoint(&state)
+		if e != nil {
+			t.Fatal(e)
+		}
+		state, e = DecodeCheckpoint(image)
+		if e != nil {
+			t.Fatal(e)
+		}
+		view, e := Inspect(&state)
+		if e != nil || view.HighWater != modelHigh {
+			t.Fatal(view, e)
+		}
+	}
+	for index := range writers {
+		for _, c := range writers[index].cursors {
+			for {
+				id, e := c.Next()
+				if errors.Is(e, ErrExhausted) {
+					break
+				}
+				if e != nil || seen[id] {
+					t.Fatal("duplicate on tail", id, e)
+				}
+				seen[id] = true
+			}
+		}
+	}
+	if abandoned == 0 || len(seen) == 0 {
+		t.Fatal("model did not exercise gaps/minting")
+	}
+	t.Logf("400 schedules, high=%d unique minted=%d discarded block accounting=%d", modelHigh, len(seen), abandoned)
+}
+
+func TestIndependentRecipientBindingBoundaryAndConcurrentExactSet(t *testing.T) {
+	graph := GraphID{1}
+	session := RecipientSession{ID: [16]byte{2}, Incarnation: [16]byte{3}, Epoch: 1}
+	authority, e := NewAuthority([16]byte{4}, 1)
+	if e != nil {
+		t.Fatal(e)
+	}
+	state, e := NewState(graph, authority, MaxBlockSize)
+	if e != nil {
+		t.Fatal(e)
+	}
+	state.high = math.MaxUint64 - 64
+	request := GrantRequest{Graph: graph, Session: session, Sequence: math.MaxUint64, Count: 64}
+	_, block, _, e := Reserve(&state, Request{Graph: graph, Authority: authority, Sequence: 1, Count: 64})
+	if e != nil {
+		t.Fatal(e)
+	}
+	for _, field := range []string{"graph", "session-id", "incarnation", "epoch", "sequence", "count", "zero-range"} {
+		t.Run(field, func(t *testing.T) {
+			recipient, e := NewRecipient(graph, session)
+			if e != nil {
+				t.Fatal(e)
+			}
+			grant := Grant{Request: request, Reservation: block}
+			switch field {
+			case "graph":
+				grant.Request.Graph[0]++
+			case "session-id":
+				grant.Request.Session.ID[0]++
+			case "incarnation":
+				grant.Request.Session.Incarnation[0]++
+			case "epoch":
+				grant.Request.Session.Epoch++
+			case "sequence":
+				grant.Request.Sequence--
+			case "count":
+				grant.Reservation.Request.Count--
+			case "zero-range":
+				grant.Reservation.First = 0
+			}
+			if _, e = recipient.Acquire(t.Context(), request, func(GrantRequest) (Grant, error) { return grant, nil }); !errors.Is(e, ErrPayloadMismatch) {
+				t.Fatal(e)
+			}
+		})
+	}
+	recipient, e := NewRecipient(graph, session)
+	if e != nil {
+		t.Fatal(e)
+	}
+	cursor, e := recipient.Acquire(t.Context(), request, func(GrantRequest) (Grant, error) { return Grant{Request: request, Reservation: block}, nil })
+	if e != nil {
+		t.Fatal(e)
+	}
+	ids := make(chan uint64, 64)
+	failures := make(chan error, 8)
+	var wg sync.WaitGroup
+	for range 8 {
+		wg.Go(func() {
+			for range 8 {
+				id, e := cursor.Next()
+				if e != nil {
+					failures <- e
+					return
+				}
+				ids <- id
+			}
+		})
+	}
+	wg.Wait()
+	close(ids)
+	if len(failures) > 0 {
+		t.Fatal(<-failures)
+	}
+	seen := map[uint64]bool{}
+	for id := range ids {
+		if id < math.MaxUint64-63 || seen[id] {
+			t.Fatal(id)
+		}
+		seen[id] = true
+	}
+	if len(seen) != 64 || !seen[math.MaxUint64] {
+		t.Fatal("inexact terminal set", len(seen))
+	}
+	if id, e := cursor.Next(); id != 0 || !errors.Is(e, ErrExhausted) {
+		t.Fatal("wrapped", id, e)
+	}
+	wrapped := request
+	wrapped.Sequence = 0
+	if _, e = recipient.Acquire(t.Context(), wrapped, func(GrantRequest) (Grant, error) { t.Fatal("wrapped request delivered"); return Grant{}, nil }); !errors.Is(e, ErrInvalid) {
+		t.Fatal(e)
+	}
+}
