+package txnproto
+
+import (
+	"errors"
+	"testing"
+)
+
+// A can complete activation while B's publication is lost. The owner's recovery
+// change allows the next incarnation to fence B's still-fenced prior incarnation.
+// The replay fix must preserve that valid transition, rather than treating any
+// fenced record as globally terminal regardless of session.
+func TestIndependentReplayFixPreservesPriorFencedRecipientRecovery(t *testing.T) {
+	n := allocationNetwork(t)
+	p, e := n.hosts[1].TransferAllocator(n.read(t, 1, Query{Kind: AllocatorState}))
+	n.submit(t, 1, p, e)
+	other := activateRecipient(t, n, 4, [16]byte{142})
+	otherCursor, otherGrant := acquire(t, n, other, 1, 4)
+	key := [16]byte{141}
+	firstBegin, e := n.hosts[1].BeginRecipient(key, Proof{})
+	n.submit(t, 1, firstBegin, e)
+	first := n.read(t, 1, Query{Kind: RecipientState, RecipientID: key})
+	firstFence, e := FenceRecipient(first)
+	if e != nil {
+		t.Fatal(e)
+	}
+	for _, dest := range []uint64{1, 4} {
+		n.submit(t, dest, firstFence, nil)
+	}
+	a := n.read(t, 1, Query{Kind: RecipientState, RecipientID: key})
+	b := n.read(t, 4, Query{Kind: RecipientState, RecipientID: key})
+	p, e = ActivateRecipient(a, b)
+	n.submit(t, 1, p, e)
+	active := n.read(t, 1, Query{Kind: RecipientState, RecipientID: key})
+	// Omit PublishRecipient deliberately: A is active while B remains fenced.
+	if active.View().Recipient.Phase != "active" || n.read(t, 4, Query{Kind: RecipientState, RecipientID: key}).View().Recipient.Phase != "fenced" {
+		t.Fatal("publication-loss fixture not reached")
+	}
+	p, e = n.hosts[1].BeginRecipient(key, active)
+	n.submit(t, 1, p, e)
+	second := n.read(t, 1, Query{Kind: RecipientState, RecipientID: key})
+	if second.View().Recipient.Session.Epoch != 2 || second.View().Recipient.Phase != "pending" {
+		t.Fatal("replacement pending not committed")
+	}
+	secondFence, e := FenceRecipient(second)
+	if e != nil {
+		t.Fatal(e)
+	}
+	for _, dest := range []uint64{4, 1} {
+		n.submit(t, dest, secondFence, nil)
+		if n.hosts[dest].machine.last != nil {
+			t.Fatal("valid prior-fenced recovery rejected", dest, n.hosts[dest].machine.last)
+		}
+	}
+	a = n.read(t, 1, Query{Kind: RecipientState, RecipientID: key})
+	b = n.read(t, 4, Query{Kind: RecipientState, RecipientID: key})
+	if b.View().Recipient.Session.Epoch != 2 || b.View().Recipient.Phase != "fenced" {
+		t.Fatal("prior fenced session was not replaced", b.View().Recipient)
+	}
+	p, e = ActivateRecipient(a, b)
+	n.submit(t, 1, p, e)
+	active = n.read(t, 1, Query{Kind: RecipientState, RecipientID: key})
+	p, e = PublishRecipient(active)
+	n.submit(t, 4, p, e)
+	handle, e := n.hosts[1].OpenRecipient(active)
+	if e != nil {
+		t.Fatal(e)
+	}
+	cursor, grant := acquire(t, n, handle, 1, 2)
+	before := [2]*RecipientRecord{}
+	for index, dest := range []uint64{1, 4} {
+		before[index] = n.read(t, dest, Query{Kind: RecipientState, RecipientID: key}).View().Recipient
+	}
+	// Same-session late fence is harmless; the previous session cannot overwrite it.
+	for _, dest := range []uint64{1, 4} {
+		n.submit(t, dest, secondFence, nil)
+		if n.hosts[dest].machine.last != nil {
+			t.Fatal("same-session replay rejected", dest, n.hosts[dest].machine.last)
+		}
+		n.submit(t, dest, firstFence, nil)
+		if !errors.Is(n.hosts[dest].machine.last, ErrStale) {
+			t.Fatal("old session fence accepted", dest, n.hosts[dest].machine.last)
+		}
+	}
+	n.submit(t, 1, firstBegin, nil)
+	if !errors.Is(n.hosts[1].machine.last, ErrStale) {
+		t.Fatal("old begin accepted")
+	}
+	for index, dest := range []uint64{1, 4} {
+		if digest(before[index]) != digest(n.read(t, dest, Query{Kind: RecipientState, RecipientID: key}).View().Recipient) {
+			t.Fatal("replayed fence changed recovered session", dest)
+		}
+	}
+	id, e := cursor.Next()
+	if e != nil || id != 5 {
+		t.Fatal(id, e)
+	}
+	x := tx("recovered-current", 0, participant(0, 0, Effect{Key: "new", Value: int64(id)}))
+	p, e = LocalIDs(x, grant, []uint64{id})
+	n.submit(t, 1, p, e)
+	if n.hosts[1].machine.last != nil {
+		t.Fatal("new recovered grant rejected", n.hosts[1].machine.last)
+	}
+	otherID, e := otherCursor.Next()
+	if e != nil || otherID != 1 {
+		t.Fatal("independent cached writer invalidated", otherID, e)
+	}
+	x = tx("recovered-other", 1, participant(1, 0, Effect{Key: "other", Value: int64(otherID)}))
+	p, e = LocalIDs(x, otherGrant, []uint64{otherID})
+	n.submit(t, 4, p, e)
+	if n.hosts[4].machine.last != nil {
+		t.Fatal("other writer rejected", n.hosts[4].machine.last)
+	}
+	exact(t, *n.read(t, 1, Query{Kind: Current}).View().State, map[string]int64{"new": 5})
+	exact(t, *n.read(t, 4, Query{Kind: Current}).View().State, map[string]int64{"other": 1})
+	t.Log("A-active/B-fenced publication loss recovers epoch2; same-session replay is idempotent, old-session replay stale, disjoint cached writer remains valid")
+}
