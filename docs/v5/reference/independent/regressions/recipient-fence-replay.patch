+func TestIndependentDelayedFenceCannotRegressActiveRecipient(t *testing.T) {
+	n := allocationNetwork(t)
+	p, e := n.hosts[1].TransferAllocator(n.read(t, 1, Query{Kind: AllocatorState}))
+	n.submit(t, 1, p, e)
+	key := [16]byte{111}
+	beginProposal, e := n.hosts[1].BeginRecipient(key, Proof{})
+	n.submit(t, 1, beginProposal, e)
+	begin := n.read(t, 1, Query{Kind: RecipientState, RecipientID: key})
+	fence, e := FenceRecipient(begin)
+	if e != nil {
+		t.Fatal(e)
+	}
+	n.submit(t, 1, fence, nil)
+	n.submit(t, 4, fence, nil)
+	a := n.read(t, 1, Query{Kind: RecipientState, RecipientID: key})
+	b := n.read(t, 4, Query{Kind: RecipientState, RecipientID: key})
+	p, e = ActivateRecipient(a, b)
+	n.submit(t, 1, p, e)
+	active := n.read(t, 1, Query{Kind: RecipientState, RecipientID: key})
+	p, e = PublishRecipient(active)
+	n.submit(t, 4, p, e)
+	h, e := n.hosts[1].OpenRecipient(active)
+	if e != nil {
+		t.Fatal(e)
+	}
+	cursor, grant := acquire(t, n, h, 1, 2)
+	// A delayed duplicate of the legitimately committed begin's fence is still
+	// old work. It cannot undo activation, zero LastSequence, or revoke this grant.
+	n.submit(t, 1, fence, nil)
+	after := n.read(t, 1, Query{Kind: RecipientState, RecipientID: key}).View().Recipient
+	id, mintErr := cursor.Next()
+	write := tx("independent-delayed-fence-cached", 0, participant(0, 0, Effect{Key: "cached", Value: int64(id)}))
+	p, e = LocalIDs(write, grant, []uint64{id})
+	n.submit(t, 1, p, e)
+	writeErr := n.hosts[1].machine.last
+	_, refillErr := h.Acquire(t.Context(), 2, 1, allocationTransport(t, n, 1))
+	if after.Phase != "active" || after.LastSequence != 1 || after.Session != active.View().Recipient.Session || id != grant.View().Grant.First || mintErr != nil || writeErr != nil || refillErr != nil {
+		t.Fatalf("delayed fence regressed active recipient: phase=%s sequence=%d session=%+v; grant [%d,%d]; mint=%d/%v cached-write=%v refill=%v", after.Phase, after.LastSequence, after.Session, grant.View().Grant.First, grant.View().Grant.Last, id, mintErr, writeErr, refillErr)
+	}
+}
