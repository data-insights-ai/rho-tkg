+func TestIndependentPublicBoundariesAndActualSessionEvidence(t *testing.T) {
+	n := allocationNetwork(t)
+	service := n.read(t, 1, Query{Kind: AllocatorState})
+	p, e := n.hosts[1].TransferAllocator(service)
+	n.submit(t, 1, p, e)
+	h := activateRecipient(t, n, 4, [16]byte{71})
+	active := n.read(t, 4, Query{Kind: RecipientState, RecipientID: h.session.ID})
+	var nilHost *Host
+	var nilHandle *RecipientHandle
+	for _, call := range []func() error{
+		func() error { _, e := nilHost.OpenRecipient(active); return e },
+		func() error { _, e := nilHost.TransferAllocator(service); return e },
+		func() error { _, e := nilHost.BeginRecipient([16]byte{1}, Proof{}); return e },
+		func() error { _, e := nilHost.AuthorizeReserve(Proposal{}, service); return e },
+		func() error { _, e := nilHandle.Acquire(t.Context(), 1, 1, allocationTransport(t, n, 4)); return e },
+		func() error { _, e := h.Acquire(nil, 1, 1, allocationTransport(t, n, 4)); return e }, //nolint:staticcheck // Required nil-input contract.
+		func() error { _, e := h.Acquire(t.Context(), 1, 1, nil); return e },
+		func() error { _, e := n.hosts[4].BeginRecipient([16]byte{}, Proof{}); return e },
+	} {
+		if e := call(); !errors.Is(e, ErrInvalid) {
+			t.Fatal(e)
+		}
+	}
+	if _, e = n.hosts[4].OpenRecipient(active); !errors.Is(e, idalloc.ErrAlreadyReserved) {
+		t.Fatal("second live session opened", e)
+	}
+	if _, e = n.hosts[1].OpenRecipient(active); !errors.Is(e, ErrStale) {
+		t.Fatal("other host opened session", e)
+	}
+	if _, e = n.hosts[4].BeginRecipient(h.session.ID, service); !errors.Is(e, ErrStale) {
+		t.Fatal("allocator evidence used as recipient", e)
+	}
+	if _, e = n.hosts[4].BeginRecipient([16]byte{99}, active); !errors.Is(e, ErrStale) {
+		t.Fatal("proof did not bind recipient ID", e)
+	}
+	for _, call := range []func() error{
+		func() error { _, e := FenceRecipient(service); return e },
+		func() error { _, e := ActivateRecipient(service, active); return e },
+		func() error { _, e := PublishRecipient(service); return e },
+		func() error { _, e := InstallGrant(active); return e },
+		func() error { _, e := RecordRecipientFence(service); return e },
+	} {
+		if e := call(); !errors.Is(e, ErrUnavailable) {
+			t.Fatal("wrong evidence kind accepted", e)
+		}
+	}
+	if _, e = n.hosts[1].AuthorizeReserve(Proposal{}, service); !errors.Is(e, ErrInvalid) {
+		t.Fatal(e)
+	}
+	if _, e = n.hosts[1].AuthorizeReserve(Proposal{}, active); !errors.Is(e, ErrInvalid) {
+		t.Fatal(e)
+	}
+	for _, request := range []struct{ sequence, count uint64 }{{0, 1}, {1, 0}, {1, idalloc.MaxBlockSize + 1}} {
+		if _, e = h.Acquire(t.Context(), request.sequence, request.count, func(context.Context, Proposal, Query) (Reply, error) {
+			t.Fatal("invalid request submitted")
+			return Reply{}, nil
+		}); !errors.Is(e, idalloc.ErrInvalid) {
+			t.Fatal(e)
+		}
+	}
+	ctx, cancel := context.WithCancel(t.Context())
+	cancel()
+	if _, e = h.Acquire(ctx, 1, 1, func(context.Context, Proposal, Query) (Reply, error) {
+		t.Fatal("cancelled request submitted")
+		return Reply{}, nil
+	}); !errors.Is(e, context.Canceled) {
+		t.Fatal(e)
+	}
+	// The cancellation did not burn sequence 1; real quorum evidence grants it.
+	_, grant := acquire(t, n, h, 1, 1)
+	if grant.View().Grant.First != 1 {
+		t.Fatal(grant.View())
+	}
+	for _, call := range []func() error{
+		func() error { _, e := RegisterIDs(tx("no-grant", 0, participant(0, 0)), active, []uint64{1}); return e },
+		func() error { _, e := LocalIDs(tx("no-grant", 0, participant(0, 0)), active, []uint64{1}); return e },
+	} {
+		if e := call(); !errors.Is(e, ErrUnavailable) {
+			t.Fatal(e)
+		}
+	}
+	if e = n.hosts[4].Close(); e != nil {
+		t.Fatal(e)
+	}
+	for _, call := range []func() error{
+		func() error { _, e := n.hosts[4].OpenRecipient(active); return e },
+		func() error { _, e := n.hosts[4].BeginRecipient(h.session.ID, active); return e },
+		func() error { _, e := n.hosts[4].TransferAllocator(service); return e },
+		func() error { _, e := n.hosts[4].AuthorizeReserve(Proposal{}, service); return e },
+	} {
+		if e := call(); !errors.Is(e, ErrUnavailable) {
+			t.Fatal("closed host remained active", e)
+		}
+	}
+	if _, e = h.Acquire(t.Context(), 2, 1, func(context.Context, Proposal, Query) (Reply, error) {
+		t.Fatal("closed host submitted")
+		return Reply{}, nil
+	}); !errors.Is(e, ErrStale) {
+		t.Fatal(e)
+	}
+}
