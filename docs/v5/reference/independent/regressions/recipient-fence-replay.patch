+func TestIndependentSessionSequenceBoundsAndCoordinatorRequestBinding(t *testing.T) {
+	n := allocationNetwork(t)
+	p, e := n.hosts[1].TransferAllocator(n.read(t, 1, Query{Kind: AllocatorState}))
+	n.submit(t, 1, p, e)
+	a := activateRecipient(t, n, 1, [16]byte{91})
+	b := activateRecipient(t, n, 4, [16]byte{92})
+	if a.session.ID == b.session.ID || a.session.Incarnation == b.session.Incarnation || a.session.Epoch != 1 || b.session.Epoch != 1 {
+		t.Fatal("writers share session")
+	}
+	// A recipient's max sequence does not consume the graph's max sequence.
+	_, g := acquire(t, n, b, ^uint64(0), 1)
+	if g.View().Grant.Sequence != 1 || g.View().Grant.Request.Sequence != ^uint64(0) {
+		t.Fatal("session and global sequences mixed", g.View().Grant)
+	}
+	if _, e = b.Acquire(t.Context(), 0, 1, func(context.Context, Proposal, Query) (Reply, error) {
+		t.Fatal("wrapped request submitted")
+		return Reply{}, nil
+	}); !errors.Is(e, idalloc.ErrInvalid) {
+		t.Fatal(e)
+	}
+	_, other := acquire(t, n, a, 1, 2)
+	if other.View().Grant.First != 2 {
+		t.Fatal("other writer sequence blocked", other.View().Grant)
+	}
+	x := tx("independent-bound-request", 0, participant(0, 0, Effect{Key: "one", Value: 2}))
+	p, e = LocalIDs(x, other, []uint64{2})
+	n.submit(t, 1, p, e)
+	if n.hosts[1].machine.last != nil {
+		t.Fatal(n.hosts[1].machine.last)
+	}
+	changed := x
+	changed.ID = "independent-reused-request"
+	changed.Participants = []Participant{participant(0, 1, Effect{Key: "phantom", Value: 3})}
+	p, e = LocalIDs(changed, other, []uint64{3})
+	n.submit(t, 1, p, e)
+	if !errors.Is(n.hosts[1].machine.last, ErrMismatch) {
+		t.Fatal("coordinator request rebound", n.hosts[1].machine.last)
+	}
+	changed = x
+	changed.Request = "different-request"
+	p, e = LocalIDs(changed, other, []uint64{2})
+	n.submit(t, 1, p, e)
+	if !errors.Is(n.hosts[1].machine.last, ErrMismatch) {
+		t.Fatal("transaction identity rebound", n.hosts[1].machine.last)
+	}
+	changed = x
+	changed.ID = "foreign-graph"
+	changed.Request = "foreign-graph"
+	changed.Graph = "another-graph"
+	p, e = LocalIDs(changed, other, []uint64{3})
+	n.submit(t, 1, p, e)
+	if !errors.Is(n.hosts[1].machine.last, ErrStale) {
+		t.Fatal("grant crossed graph", n.hosts[1].machine.last)
+	}
+	// Publicly invalid version is rejected before proposing any replicated work.
+	p.command.Version++
+	if _, e = n.hosts[1].Submit(p); !errors.Is(e, ErrInvalid) {
+		t.Fatal("wrong protocol version accepted", e)
+	}
+	exact(t, *n.read(t, 1, Query{Kind: Current}).View().State, map[string]int64{"one": 2})
+	t.Log("distinct home sessions, recipient max sequence/global sequence 1, immutable coordinator request/Tx identity, foreign graph absent")
+}
