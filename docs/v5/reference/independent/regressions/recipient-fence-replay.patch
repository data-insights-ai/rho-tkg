+func TestIndependentUnavailableAuthorityAndDefiniteCountRejection(t *testing.T) {
+	n := allocationNetwork(t)
+	p, e := n.hosts[1].TransferAllocator(n.read(t, 1, Query{Kind: AllocatorState}))
+	n.submit(t, 1, p, e)
+	h := activateRecipient(t, n, 4, [16]byte{101})
+	// Count is locally bounded, but exceeds this graph's committed block bound.
+	_, e = h.Acquire(t.Context(), 1, 17, func(_ context.Context, intent Proposal, _ Query) (Reply, error) {
+		p, e := n.hosts[1].AuthorizeReserve(intent, n.read(t, 1, Query{Kind: AllocatorState}))
+		if e != nil {
+			return Reply{}, e
+		}
+		n.submit(t, 1, p, nil)
+		if !errors.Is(n.hosts[1].machine.last, idalloc.ErrInvalid) {
+			t.Fatal("graph block maximum ignored", n.hosts[1].machine.last)
+		}
+		return Reply{}, n.hosts[1].machine.last
+	})
+	if !errors.Is(e, idalloc.ErrUnknown) || !errors.Is(e, idalloc.ErrInvalid) {
+		t.Fatal(e)
+	}
+	if n.read(t, 1, Query{Kind: AllocatorState}).View().Allocator.HighWater != 0 {
+		t.Fatal("rejected block consumed range")
+	}
+	cursor, g := acquire(t, n, h, 2, 16)
+	if g.View().Grant.First != 1 || g.View().Grant.Last != 16 {
+		t.Fatal(g.View().Grant)
+	}
+	service := n.read(t, 1, Query{Kind: AllocatorState})
+	for _, id := range []uint64{1, 2, 3} {
+		n.drop[id] = true
+	}
+	_, e = h.Acquire(t.Context(), 3, 1, func(_ context.Context, intent Proposal, q Query) (Reply, error) {
+		p, e := n.hosts[1].AuthorizeReserve(intent, service)
+		if e != nil {
+			return Reply{}, e
+		}
+		out, e := n.hosts[1].Submit(p)
+		n.run(t, 1, out, e)
+		n.replies[1] = nil
+		out, e = n.hosts[1].Read(q)
+		n.run(t, 1, out, e)
+		for _, reply := range n.replies[1] {
+			if reply.ReadID == out.ReadID && reply.Err == nil {
+				t.Fatal("new grant proof while allocator quorum unavailable")
+			}
+		}
+		return Reply{}, ErrUnavailable
+	})
+	if !errors.Is(e, idalloc.ErrUnknown) {
+		t.Fatal("unavailable authority minted", e)
+	}
+	if _, e = h.Acquire(t.Context(), 3, 1, func(context.Context, Proposal, Query) (Reply, error) {
+		t.Fatal("uncertain request resubmitted")
+		return Reply{}, nil
+	}); !errors.Is(e, idalloc.ErrAlreadyReserved) {
+		t.Fatal(e)
+	}
+	id, e := cursor.Next()
+	if e != nil || id != 1 {
+		t.Fatal("quorum loss revoked cached range", id, e)
+	}
+	for _, id := range []uint64{1, 2, 3} {
+		delete(n.drop, id)
+	}
+	n.elect(t, 1)
+	high := n.read(t, 1, Query{Kind: AllocatorState}).View().Allocator.HighWater
+	if high < 16 || high > 17 {
+		t.Fatal("unknown attempt corrupted high-water", high)
+	}
+	_, later := acquire(t, n, h, 4, 1)
+	if later.View().Grant.First != high+1 {
+		t.Fatal("post-outage overlapping range", later.View().Grant, high)
+	}
+	t.Logf("bound rejection reserves nothing; unavailable refill burns attempt; cached ID1 stays local; post-recovery high=%d", high)
+}
