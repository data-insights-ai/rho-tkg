+func TestIndependentReplyTamperingUnknownAndRecovery(t *testing.T) {
+	for _, fault := range []string{"transport-before", "transport-after", "reply-error", "query-count", "read-sequence", "read-session", "prior-proof"} {
+		t.Run(fault, func(t *testing.T) {
+			n := allocationNetwork(t)
+			p, e := n.hosts[1].TransferAllocator(n.read(t, 1, Query{Kind: AllocatorState}))
+			n.submit(t, 1, p, e)
+			h := activateRecipient(t, n, 4, [16]byte{81})
+			prior := n.read(t, 4, Query{Kind: RecipientState, RecipientID: h.session.ID})
+			_, e = h.Acquire(t.Context(), 1, 2, func(ctx context.Context, p Proposal, q Query) (Reply, error) {
+				if fault == "transport-before" {
+					return Reply{}, ErrUnavailable
+				}
+				reply, e := allocationTransport(t, n, 4)(ctx, p, q)
+				if e != nil {
+					return Reply{}, e
+				}
+				switch fault {
+				case "transport-after":
+					return Reply{}, ErrUnavailable
+				case "reply-error":
+					reply.Err = ErrUnavailable
+				case "query-count":
+					reply.Query.Count++
+				case "read-sequence":
+					reply.ReadID.Sequence++
+				case "read-session":
+					reply.ReadID.Session[0]++
+				case "prior-proof":
+					reply.Proof = prior
+				}
+				return reply, nil
+			})
+			want := ErrMismatch
+			if fault == "transport-before" || fault == "transport-after" || fault == "reply-error" {
+				want = idalloc.ErrUnknown
+			}
+			if !errors.Is(e, want) {
+				t.Fatal("bad delivery accepted", e, want)
+			}
+			if _, e = h.Acquire(t.Context(), 1, 2, func(context.Context, Proposal, Query) (Reply, error) {
+				t.Fatal("uncertain attempt redelivered")
+				return Reply{}, nil
+			}); !errors.Is(e, idalloc.ErrAlreadyReserved) {
+				t.Fatal(e)
+			}
+			cursor, g := acquire(t, n, h, 2, 2)
+			expected := uint64(3)
+			if fault == "transport-before" {
+				expected = 1
+			}
+			id, e := cursor.Next()
+			if e != nil || id != expected || g.View().Grant.First != expected {
+				t.Fatal("uncertain range reused", id, e, g.View().Grant)
+			}
+			exact(t, *n.read(t, 4, Query{Kind: Current}).View().State, map[string]int64{})
+		})
+	}
+}
