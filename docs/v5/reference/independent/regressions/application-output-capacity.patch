+func TestIndependentHistoricalScanExactReference(t *testing.T) {
+	s := openApplication(t, vfs.NewMem(), DefaultApplicationPolicy(1))
+	var models []map[string]KV
+	model := map[string]KV{}
+	models = append(models, model)
+	for step := range 12 {
+		next := maps.Clone(model)
+		var writes []KV
+		for k := range 15 {
+			if (step+k)%3 != 0 {
+				continue
+			}
+			key := fmt.Sprintf("%02d", k)
+			row := KV{Key: []byte(key), Value: []byte(fmt.Sprintf("%d:%d", step, k))}
+			if (step+k)%4 == 0 {
+				row.Value = nil
+				row.Deleted = true
+			}
+			writes = append(writes, row)
+			next[key] = row
+		}
+		applyApplication(t, s, fmt.Sprintf("step%d", step), writes...)
+		model = next
+		models = append(models, model)
+	}
+	for ordinal, m := range models {
+		v := viewApplication(t, s, uint64(ordinal+1))
+		seen := map[string]string{}
+		var after []byte
+		for pages := 0; ; pages++ {
+			if pages > 16 {
+				t.Fatal("cursor stalled")
+			}
+			page, err := v.Scan(t.Context(), []byte("03"), []byte("12"), after, ReadBudget{2, 200})
+			if err != nil || page.Visited > 2 || page.Bytes > 200 {
+				t.Fatal(page, err)
+			}
+			for _, r := range page.Rows {
+				key := string(r.Key)
+				if _, dup := seen[key]; dup {
+					t.Fatal("duplicate", key)
+				}
+				seen[key] = string(r.Value)
+			}
+			if page.Complete {
+				break
+			}
+			if bytes.Compare(page.Next, after) <= 0 {
+				t.Fatal("cursor regressed")
+			}
+			after = page.Next
+		}
+		want := map[string]string{}
+		for k, row := range m {
+			if k >= "03" && k < "12" && !row.Deleted {
+				want[k] = string(row.Value)
+			}
+		}
+		if len(seen) != len(want) {
+			t.Fatal(ordinal, seen, want)
+		}
+		for k, value := range want {
+			if got, ok := seen[k]; !ok || got != value {
+				t.Fatal(ordinal, k, got, value)
+			}
+		}
+	}
+}
