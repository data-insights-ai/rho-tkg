+func independentLogicalLedger(t *testing.T, s *Store) (uint64, uint64) {
+	t.Helper()
+	it, err := s.db.NewIter(&pebble.IterOptions{LowerBound: []byte{appDataTag}, UpperBound: []byte{appOutcomeTag + 1}})
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer func() {
+		if err := it.Close(); err != nil {
+			t.Error(err)
+		}
+	}()
+	var n, count uint64
+	for ok := it.First(); ok; ok = it.Next() {
+		n += uint64(len(it.Key()) + len(it.Value()))
+		count++
+	}
+	if err := it.Error(); err != nil {
+		t.Fatal(err)
+	}
+	return n, count
+}
