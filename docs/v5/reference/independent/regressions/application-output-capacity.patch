+func TestIndependentApplicationExactLedgerAndRefusal(t *testing.T) {
+	fs := vfs.NewCrashableMem()
+	p := DefaultApplicationPolicy(1)
+	p.ReclaimEntries = 2
+	s := openApplication(t, fs, p)
+	applyApplication(t, s, "second", KV{Key: []byte{0, 0, 'a'}, Value: []byte("one")}, KV{Key: []byte("z"), Deleted: true})
+	beforeBytes, beforeCount := independentLogicalLedger(t, s)
+	use, err := s.ApplicationUsage()
+	if err != nil || beforeBytes != use.RetainedBytes || beforeCount != use.RetainedRecords {
+		t.Fatal(beforeBytes, beforeCount, use, err)
+	}
+	persist(t, s, 2, 3, ent(3, 2, "pending"))
+	_, image, err := s.Checkpoint()
+	if err != nil {
+		t.Fatal(err)
+	}
+	good := ApplicationBatch{BaseIndex: 2, BaseImageHash: sha256.Sum256(image), Image: []byte("third"), Writes: []KV{{Key: []byte("a"), Value: []byte("three")}}}
+	for _, scenario := range []string{"key", "image", "change", "outcome", "order", "index", "hash"} {
+		b := good
+		want := ErrLimit
+		index := uint64(3)
+		switch scenario {
+		case "key":
+			b.Writes = []KV{{Key: make([]byte, p.MaxKeyBytes+1)}}
+		case "image":
+			b.Image = make([]byte, p.MaxImageBytes+1)
+		case "change":
+			b.Changes = make([]byte, p.MaxChangeBytes+1)
+		case "outcome":
+			b.Outcome = make([]byte, p.MaxOutcomeBytes+1)
+		case "order":
+			b.Writes = []KV{{Key: []byte("z")}, {Key: []byte("a")}}
+			want = ErrInvalid
+		case "index":
+			index = 4
+			want = ErrInvalid
+		case "hash":
+			b.BaseImageHash = [32]byte{1}
+			want = ErrInvalid
+		}
+		metadataBefore, _ := encodeMeta(s.meta)
+		if err := s.InstallApplication(index, b); !errors.Is(err, want) {
+			t.Fatal(scenario, err)
+		}
+		metadataAfter, _ := encodeMeta(s.meta)
+		n, count := independentLogicalLedger(t, s)
+		if !bytes.Equal(metadataBefore, metadataAfter) || n != beforeBytes || count != beforeCount {
+			t.Fatal("refusal mutated store", scenario)
+		}
+	}
+	if err := s.InstallApplication(3, good); err != nil {
+		t.Fatal(err)
+	}
+	if err := s.ReclaimApplication(); err != nil {
+		t.Fatal(err)
+	}
+	n, count := independentLogicalLedger(t, s)
+	use, err = s.ApplicationUsage()
+	if err != nil || n != use.RetainedBytes || count != use.RetainedRecords || use.TailBytes != 0 {
+		t.Fatal(n, count, use, err)
+	}
+	r, err := Open(Config{Dir: "app", FS: fs.CrashClone(vfs.CrashCloneCfg{}), Application: p})
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer r.Close()
+	if err := r.ScrubApplication(t.Context()); err != nil {
+		t.Fatal(err)
+	}
+	if idx, image, err := r.Checkpoint(); err != nil || idx != 3 || string(image) != "third" {
+		t.Fatal(idx, string(image), err)
+	}
+	getApplication(t, viewApplication(t, r, 2), string([]byte{0, 0, 'a'}), "one", true, false)
+	getApplication(t, viewApplication(t, r, 3), "a", "three", true, false)
+}
