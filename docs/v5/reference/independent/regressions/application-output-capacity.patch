+			} else {
+				batch.Changes = payload
+			}
+			if err := s.InstallApplication(2, batch); err != nil {
+				t.Fatal(err)
+			}
+			if _, err := s.ApplicationRecord(t.Context(), 2, outcome, p.MaxPageBytes-1); !errors.Is(err, ErrLimit) {
+				t.Fatal(err)
+			}
+			record, err := s.ApplicationRecord(t.Context(), 2, outcome, p.MaxPageBytes)
+			if err != nil || len(record) != len(payload) {
+				t.Fatal(len(record), err)
+			}
+		})
+	}
+}
