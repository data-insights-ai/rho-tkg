+func TestIndependentApplicationReadFaultPoisons(t *testing.T) {
+	for _, operation := range []string{"Get", "Scan", "Scrub", "Record"} {
+		t.Run(operation, func(t *testing.T) {
+			toggle := &errorfs.Toggle{Injector: errorfs.InjectorFunc(func(op errorfs.Op) error {
+				if op.Kind == errorfs.OpFileReadAt {
+					return errorfs.ErrInjected
+				}
+				return nil
+			})}
+			l := DefaultLimits()
+			l.CacheBytes = 1
+			s, err := Open(Config{Dir: "fault", FS: errorfs.Wrap(vfs.NewMem(), toggle), Create: true, Limits: l, Application: DefaultApplicationPolicy(1)})
+			if err != nil {
+				t.Fatal(err)
+			}
+			t.Cleanup(func() {
+				toggle.Off()
+				if err := s.Close(); err != nil {
+					t.Error(err)
+				}
+			})
+			if err := s.Initialize([]uint64{1}, nil); err != nil {
+				t.Fatal(err)
+			}
+			applyApplication(t, s, "root", KV{Key: []byte("a"), Value: []byte("value")})
+			v := viewApplication(t, s, 2)
+			if err := s.db.Flush(); err != nil {
+				t.Fatal(err)
+			}
+			toggle.On()
+			switch operation {
+			case "Get":
+				_, _, err = v.Get(t.Context(), []byte("a"), 128)
+			case "Scan":
+				_, err = v.Scan(t.Context(), nil, nil, nil, ReadBudget{1, 128})
+			case "Scrub":
+				err = s.ScrubApplication(t.Context())
+			case "Record":
+				_, err = s.ApplicationRecord(t.Context(), 2, false, 128)
+			}
+			if !errors.Is(err, errorfs.ErrInjected) {
+				t.Fatal("I/O fixture did not reach reader", operation, err)
+			}
+			if _, err := s.ApplicationUsage(); !errors.Is(err, ErrPoisoned) || !errors.Is(err, errorfs.ErrInjected) {
+				t.Fatal("read error failed to poison", err)
+			}
+		})
+	}
+}
