+func TestIndependentPageBudgetBoundaries(t *testing.T) {
+	for _, valueBytes := range []int{1, 128, 1 << 20} {
+		t.Run(fmt.Sprint(valueBytes), func(t *testing.T) {
+			p := DefaultApplicationPolicy(1)
+			p.MaxKeyBytes = 128
+			p.MaxValueBytes = valueBytes
+			p.MaxImageBytes = 16
+			p.MaxChangeBytes = 16
+			p.MaxOutcomeBytes = 16
+			p.MaxViewBytes = 16
+			p.MaxPageBytes = 2*p.MaxKeyBytes + p.MaxValueBytes + 64
+			smaller := p
+			smaller.MaxPageBytes--
+			fs := vfs.NewMem()
+			if s, err := Open(Config{Dir: "rejected", FS: fs, Create: true, Application: smaller}); !errors.Is(err, ErrInvalid) {
+				if s != nil {
+					s.Close()
+				}
+				t.Fatal("one-byte-small page policy accepted", err)
+			}
+			if _, err := fs.Stat("rejected"); err == nil {
+				t.Fatal("policy refusal created durable directory")
+			}
+			s := openApplication(t, fs, p)
+			key := bytes.Repeat([]byte{'a'}, p.MaxKeyBytes)
+			applyApplication(t, s, "max", KV{Key: key, Value: make([]byte, valueBytes)})
+			v := viewApplication(t, s, 2)
+			before, _ := encodeMeta(s.meta)
+			if _, err := v.Scan(t.Context(), nil, nil, nil, ReadBudget{1, p.MaxPageBytes - 1}); !errors.Is(err, ErrLimit) {
+				t.Fatal("short read budget accepted", err)
+			}
+			after, _ := encodeMeta(s.meta)
+			if !bytes.Equal(before, after) {
+				t.Fatal("read refusal mutated durable state")
+			}
+			page, err := v.Scan(t.Context(), nil, nil, nil, ReadBudget{1, p.MaxPageBytes})
+			if err != nil || !page.Complete || len(page.Rows) != 1 || page.Bytes > p.MaxPageBytes {
+				t.Fatal(page, err)
+			}
+			if cap(page.Rows[0].Key) != len(key) || cap(page.Rows[0].Value) != valueBytes {
+				t.Fatal("returned bytes expose spare capacity")
+			}
+			ctx, cancel := context.WithCancel(t.Context())
+			cancel()
+			if _, err := v.Scan(ctx, nil, nil, nil, ReadBudget{1, p.MaxPageBytes}); !errors.Is(err, context.Canceled) {
+				t.Fatal(err)
+			}
+		})
+	}
+}
