+// A policy accepted at open must let Scan return an installed maximum-sized row.
+func TestIndependentMaximumAcceptedRowMustBeScannable(t *testing.T) {
+	p := DefaultApplicationPolicy(1)
+	p.MaxKeyBytes = 1
+	p.MaxValueBytes = 1
+	p.MaxImageBytes = 16
+	p.MaxChangeBytes = 16
+	p.MaxOutcomeBytes = 16
+	p.MaxViewBytes = 16
+	p.MaxPageBytes = p.MaxKeyBytes + p.MaxValueBytes + appFrameBytes
+	if err := p.Validate(DefaultLimits()); !errors.Is(err, ErrInvalid) {
+		t.Fatal("undersized policy accepted", err)
+	}
+	p.MaxPageBytes = 2*p.MaxKeyBytes + p.MaxValueBytes + 64
+	if err := p.Validate(DefaultLimits()); err != nil {
+		t.Fatal(err)
+	}
+	s := openApplication(t, vfs.NewMem(), p)
+	applyApplication(t, s, "max", KV{Key: []byte("a"), Value: make([]byte, p.MaxValueBytes)})
+	v := viewApplication(t, s, 2)
+	if _, ok, err := v.Get(t.Context(), []byte("a"), p.MaxPageBytes); err != nil || !ok {
+		t.Fatal(ok, err)
+	}
+	page, err := v.Scan(t.Context(), nil, nil, nil, ReadBudget{1, p.MaxPageBytes})
+	if err != nil || !page.Complete || len(page.Rows) != 1 {
+		t.Fatalf("accepted legal row cannot be scanned: MaxPageBytes=%d scan requires=%d page=%+v err=%v", p.MaxPageBytes, 2*p.MaxKeyBytes+p.MaxValueBytes+64, page, err)
+	}
+}
