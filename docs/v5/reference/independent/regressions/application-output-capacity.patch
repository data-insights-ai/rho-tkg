+
+// observeApplication checks durable bytes rather than trusting callback ordering.
+type observeApplication struct {
+	applicationFixture
+	t                *testing.T
+	store            *raftlog.Store
+	bad              bool
+	stages, restores int
+}
+
+func (m *observeApplication) Stage(e Entry, b raftlog.ApplicationBudget) (raftlog.ApplicationBatch, error) {
+	before, image, err := m.store.Checkpoint()
+	if err != nil || before != m.index || !bytes.Equal(image, m.image) {
+		m.t.Fatalf("Stage saw unpublished checkpoint: %d/%d %v", before, m.index, err)
+	}
+	if e.Index != before+1 {
+		m.t.Fatal("stage order", e.Index, before)
+	}
+	if _, err := m.store.ApplicationView(e.Index); !errors.Is(err, raftlog.ErrInvalid) {
+		m.t.Fatal("unpublished view exists", err)
+	}
+	batch, err := m.applicationFixture.Stage(e, b)
+	if err != nil {
+		return batch, err
+	}
+	if beforeAfter, imageAfter, err := m.store.Checkpoint(); err != nil || beforeAfter != before || !bytes.Equal(image, imageAfter) {
+		m.t.Fatal("Stage changed durable root", err)
+	}
+	m.stages++
+	if m.bad && len(e.Data) > 0 {
+		batch.Writes = append(batch.Writes, raftlog.KV{Key: []byte("a"), Value: command(999)})
+	}
+	return batch, nil
+}
+func (m *observeApplication) Restore(index uint64, image []byte) error {
+	actual, stored, err := m.store.Checkpoint()
+	if err != nil || actual != index || !bytes.Equal(image, stored) {
+		m.t.Fatal("Restore ran before durable image", actual, index, err)
+	}
+	view, err := m.store.ApplicationView(index)
+	if err != nil {
+		m.t.Fatal(err)
+	}
+	root, err := view.Root()
+	if err != nil {
+		m.t.Fatal(err)
+	}
+	if root.Index != index || root.ImageHash != sha256.Sum256(image) || !bytes.Equal(root.Image, image) {
+		m.t.Fatal("Restore saw mixed root", root, index)
+	}
+	if err := view.Close(); err != nil {
+		m.t.Fatal(err)
+	}
+	m.restores++
+	return m.applicationFixture.Restore(index, image)
+}
+func TestIndependentApplicationPrivateStageAndPublication(t *testing.T) {
+	fs := vfs.NewCrashableMem()
+	p := raftlog.DefaultApplicationPolicy(1)
+	s, err := raftlog.Open(raftlog.Config{Dir: "observed", FS: fs, Create: true, Application: p})
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err := s.Initialize([]uint64{1}, nil); err != nil {
+		t.Fatal(err)
+	}
+	m := &observeApplication{t: t, store: s}
+	d, err := Open(Config{ID: 1, Store: s, ApplicationMachine: m})
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer d.Close()
+	packets(t, d.Campaign)
+	packets(t, func() (Output, error) { return d.Propose(command(7)) })
+	good := d.Applied()
+	fixtureRead(t, s, good, 7, false)
+	beforeStages, beforeRestores := m.stages, m.restores
+	m.bad = true
+	out, err := d.Propose(command(11))
+	if !errors.Is(err, raftlog.ErrInvalid) || out.Applied != 0 || len(out.Reads) != 0 || len(out.Packets) != 0 {
+		t.Fatal("invalid staged batch produced output", out, err)
+	}
+	if m.stages != beforeStages+1 || m.restores != beforeRestores || m.value != 7 {
+		t.Fatal("invalid batch published volatile state", m.stages, m.restores, m.value)
+	}
+	if _, err := d.Tick(); !errors.Is(err, ErrStopped) {
+		t.Fatal(err)
+	}
+	checkpoint, image, err := s.Checkpoint()
+	if err != nil || checkpoint != good || !bytes.Equal(image, command(7)) {
+		t.Fatal(checkpoint, image, err)
+	}
+	fixtureRead(t, s, good, 7, false)
+	if _, err := s.ApplicationView(good + 1); !errors.Is(err, raftlog.ErrInvalid) {
+		t.Fatal("bad install left root", err)
